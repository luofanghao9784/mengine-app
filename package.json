{
  "name": "enterprise-ai-workspace-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:git": "node scripts/setup-git.mjs",
    "test:git": "node --test tests/git-hooks.test.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:konggu": "playwright test tests/e2e/konggu.spec.ts",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts",
    "test:e2e:briefing-feedback": "playwright test tests/e2e/briefing-feedback.spec.ts tests/e2e/briefing-chats.spec.ts tests/e2e/konggu.spec.ts",
    "test:e2e:frontend": "playwright test tests/e2e/briefing-feedback.spec.ts tests/e2e/briefing-chats.spec.ts tests/e2e/briefing-magazine.spec.ts tests/e2e/konggu.spec.ts tests/e2e/conversation-deck-layout.spec.ts tests/e2e/conversation-responsive.spec.ts tests/e2e/conversation-reveal.spec.ts tests/e2e/conversation-stack-hint.spec.ts tests/e2e/conversation-elastic-scroll.spec.ts tests/e2e/briefing-follow-layout.spec.ts tests/e2e/briefing-packing.spec.ts"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
