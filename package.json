{
  "name": "enterprise-ai-workspace-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:git": "node scripts/setup-git.mjs",
    "test:git": "node --test tests/git-hooks.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/verify-built-entries.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "depcruise": "node --experimental-strip-types --test tests/frontend-boundaries.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts",
    "build:engine": "npm --prefix engine run build",
    "start:engine": "npm --prefix engine start",
    "test:engine": "npm --prefix engine test",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:foundation": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-foundation.ts",
    "test:api": "python3 scripts/with-test-postgres.py ./apps/api/mvnw -B -f apps/api/pom.xml test package",
    "test:identity:restart": "python3 scripts/with-test-postgres.py python3 scripts/verify-identity-restart.py",
    "test:access": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-access.ts",
    "test:platform-admin": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-platform.ts",
    "test:tenant-admin": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-tenant.ts",
    "trial:build": "npm run build && npm run build:engine && ./apps/api/mvnw -B -f apps/api/pom.xml -DskipTests package",
    "trial:start": "python3 scripts/local/trial.py start",
    "trial:stop": "python3 scripts/local/trial.py stop",
    "trial:status": "python3 scripts/local/trial.py status",
    "trial:invitation": "python3 scripts/local/trial.py invitation",
    "test:three-surfaces": "node --experimental-strip-types scripts/verify-three-surfaces.ts",
    "test:admin-realms": "node --experimental-strip-types scripts/verify-admin-realms.ts",
    "trial:invitations": "python3 scripts/local/trial.py invitations",
    "test:trial-safety": "python3 -m unittest discover -s tests/local -p \"*_test.py\"",
    "test:materials": "node --experimental-strip-types scripts/verify-three-surfaces.ts --materials",
    "test:revocation": "node --experimental-strip-types scripts/verify-three-surfaces.ts --revocation",
    "setup:parser": "python3 scripts/knowledge/setup.py",
    "test:parser": "workers/parser/.venv/bin/python -m unittest discover -s tests/knowledge -p \"*_test.py\"",
    "test:knowledge": "node --experimental-strip-types scripts/verify-three-surfaces.ts --knowledge",
    "test:conversations": "node --experimental-strip-types scripts/verify-three-surfaces.ts --conversations",
    "test:agent": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-agent.ts",
    "trial:backup": "python3 scripts/local/backup.py create",
    "trial:backup:verify": "python3 scripts/local/backup.py verify",
    "trial:restore": "python3 scripts/local/backup.py restore",
    "test:backup": "node --experimental-strip-types scripts/verify-three-surfaces.ts --backup",
    "engine:check": "node scripts/check-engine.mjs",
    "test:engine-upgrade": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-engine-upgrade.ts",
    "test:operations": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-operations.ts",
    "test:formats": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-formats.ts",
    "test:browsers": "node --experimental-strip-types scripts/verify-browser-matrix.ts",
    "test:e2e:frontend": "node -e \"console.log('SKIP: conversation-* e2e targets deleted Demo SPA (CT-027); frontend gate keeps A build + B unit. Restore when workspace e2e lands.');\"",
    "model:check": "npm run build:engine && node engine/scripts/check-model-config.mjs",
    "test:governance": "node --experimental-strip-types scripts/governance-journey.ts",
    "test:plans": "node --experimental-strip-types scripts/plans-journey.ts",
    "test:evaluation": "node --experimental-strip-types scripts/evaluation-methods-journey.ts",
    "test:output": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-agent.ts --output-only",
    "test:feedback": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-agent.ts --feedback-only",
    "test:object-lifecycle": "node --experimental-strip-types scripts/object-lifecycle-journey.ts",
    "test:departure": "node --experimental-strip-types scripts/verify-departure.ts",
    "test:management-configuration": "node --experimental-strip-types scripts/verify-departure.ts --management-only",
    "test:focus-layout": "node --experimental-strip-types scripts/focus-layout-journey.ts",
    "test:task-work": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-task-work.ts",
    "test:feedback-adjustment": "node --experimental-strip-types scripts/feedback-adjustment-journey.ts",
    "test:publication-feedback": "node --experimental-strip-types scripts/publication-feedback-journey.ts",
    "test:history-lifecycle": "node --experimental-strip-types scripts/history-lifecycle-journey.ts",
    "model:configure": "python3 scripts/local/live_model.py configure",
    "model:check:local": "python3 scripts/local/live_model.py check",
    "model:smoke": "python3 scripts/local/live_model.py smoke",
    "trial:start:live": "python3 scripts/local/trial.py start --live --directory .local/selfuse-live",
    "trial:stop:live": "python3 scripts/local/trial.py stop --directory .local/selfuse-live",
    "trial:status:live": "python3 scripts/local/trial.py status --directory .local/selfuse-live",
    "test:client-b1": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-phone-flow.ts --client-b1",
    "test:phone-flow": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-phone-flow.ts",
    "trial:start:phone": "python3 scripts/local/trial.py start --phone-local --directory .local/phone-trial",
    "test:client-all": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-phone-flow.ts --client-all",
    "test:onboarding-stage2": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-onboarding-stage2.ts",
    "test:unified-identity": "python3 scripts/with-test-postgres.py node --experimental-strip-types scripts/verify-unified-identity.ts",
    "test:ppt:rehearsal": "npm run build:engine && python3 scripts/local/ppt_acceptance.py synthetic",
    "test:ppt:live": "npm run build:engine && python3 scripts/local/ppt_acceptance.py live",
    "test:ppt:check": "python3 scripts/local/ppt_acceptance.py check"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.20",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "dependency-cruiser": "^18.7.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
