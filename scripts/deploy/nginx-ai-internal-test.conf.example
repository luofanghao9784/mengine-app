# Public website preview; product, login and API routes retain the internal access gate.
server {
 listen 80;
 server_name ai.9pop.top;
 location ^~ /.well-known/acme-challenge/ { root /var/lib/dreamcore/acme; }
 location / { return 301 https://ai.9pop.top$request_uri; }
}
server {
 listen 443 ssl;
 server_name ai.9pop.top;
 ssl_certificate /etc/letsencrypt/live/ai.9pop.top/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/ai.9pop.top/privkey.pem;
 auth_basic "Mengine Internal Test";
 auth_basic_user_file /etc/nginx/dreamcore-internal.htpasswd;
 root /var/www/dreamcore-site-20261010;
 index index.html;
 client_max_body_size 65m;
 add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
 add_header X-Content-Type-Options nosniff always;
 add_header X-Frame-Options SAMEORIGIN always;
 add_header Referrer-Policy same-origin always;
 add_header X-Dreamcore-Environment rehearsal always;
 location /internal/ { return 404; }
 location /actuator/ { return 404; }
 location ~ /\. { return 404; }
 location /api/ {
  proxy_pass http://127.0.0.1:18481;
  proxy_http_version 1.1;
  proxy_set_header Host ai.9pop.top;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Authorization "";
  proxy_buffering off;
  proxy_read_timeout 300s;
 }
 location /workspace/ { root /var/www/dreamcore-app-check-20261010; try_files $uri $uri/ /workspace/index.html; }
 location /tenant-admin/ { root /var/www/dreamcore-app-check-20261010; try_files $uri $uri/ /tenant-admin/index.html; }
 location /platform-admin/ { root /var/www/dreamcore-app-check-20261010; try_files $uri $uri/ /platform-admin/index.html; }
 location /assets/ { root /var/www/dreamcore-app-check-20261010; try_files $uri =404; }
 location = / { auth_basic off; try_files /index.html =404; }
 location = /index.html { auth_basic off; try_files $uri =404; }
 location = /favicon.svg { auth_basic off; try_files $uri =404; }
 location = /news-cover.svg { auth_basic off; try_files $uri =404; }
 location /website-assets/ { auth_basic off; try_files $uri =404; }
 location /demo/ {
  auth_basic off;
  if ($http_sec_fetch_dest != iframe) { return 404; }
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; frame-ancestors 'self'; form-action 'none'; base-uri 'self'" always;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  try_files $uri =404;
 }
 location / { try_files $uri $uri/ =404; }
}
