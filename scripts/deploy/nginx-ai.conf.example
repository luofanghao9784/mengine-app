# Install only after DNS, certificate and isolated migration acceptance.
# New independent vhost; do not overwrite any existing 9POP vhost.
server {
    listen 80;
    server_name ai.9pop.top;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/dreamcore/acme; }
    location / { return 301 https://ai.9pop.top$request_uri; }
}
server {
    listen 443 ssl;
    server_name ai.9pop.top;
    ssl_certificate /etc/letsencrypt/live/ai.9pop.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.9pop.top/privkey.pem;
    client_max_body_size 65m;
    location / {
        proxy_pass http://127.0.0.1:18480;
        proxy_http_version 1.1;
        proxy_set_header Host ai.9pop.top;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
