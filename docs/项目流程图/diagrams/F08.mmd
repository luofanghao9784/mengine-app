flowchart TD
  n_library["资料库"] --> n_scope["选择个人资料或获权企业空间"]
  n_scope --> n_browse["搜索、文件夹、详情、版本与来源"]
  n_scope --> n_upload["批量上传或维护文本资料"]
  n_upload --> n_process["查看解析和处理状态"]
  n_browse --> n_permission["按权限下载、编辑、移动或管理授权"]
  n_process --> n_reuse["在会话中选择资料"]
  n_browse --> n_reuse
  n_skill["技能中心"] --> n_available{"PPT 能力可用？"}
  n_available -->|"否"| n_disabled["暂未开放，显示能力边界"]
  n_available -->|"是"| n_ppt["填写目标、页数、主题并选择资料"]
  n_ppt --> n_outline["生成大纲，任务等待确认"]
  n_outline --> n_edit["核对标题、主题与页序"]
  n_edit --> n_confirm["明确确认生成"]
  n_confirm --> n_render["按确认稿渲染 PPTX 和内容源文件"]
  n_render --> n_download["获权下载成果"]
  n_reuse --> n_doc["会话成果保存为个人文稿"]
  n_doc --> n_versions["编辑版本，选择格式导出"]
  n_versions --> n_publication["明确发布到可维护的共享空间"]
  n_publication --> n_shared["共享资料与工作动态"]
  n_process -.-> ossParse["优先验证：Docling 解析"]:::ossPriority
  n_render -.-> ossPpt["已采用：PptxGenJS 4.0.1"]:::ossExisting
  n_versions -.-> ossEditor["富文本需求可用：Tiptap 编辑区"]:::ossConditional
  classDef ossPriority fill:#e4f6eb,stroke:#2e8052,color:#154b30,stroke-width:2px
  classDef ossConditional fill:#fff3d9,stroke:#ac7b27,color:#604417,stroke-width:1.5px
  classDef ossExisting fill:#f0eaff,stroke:#8063ad,color:#4a3672,stroke-width:2px
