diff --git a/src/platform/platform.css b/src/platform/platform.css
index 70555bd..877b090 100644
--- a/src/platform/platform.css
+++ b/src/platform/platform.css
@@ -471,3 +471,62 @@
   white-space: pre-wrap;
   overflow-wrap: anywhere;
 }
+
+/* 企业目录：单层工具栏与紧凑数据行。 */
+.admin-platform .platform-enterprise-catalog .platform-list-heading {
+  padding: 16px 24px;
+}
+.admin-platform .platform-enterprise-catalog .platform-filters {
+  width: 100%;
+  justify-content: space-between;
+}
+.admin-platform .platform-enterprise-catalog .platform-search {
+  width: min(360px, 100%);
+  padding-left: 0;
+  gap: 0;
+  flex: 0 1 360px;
+}
+.admin-platform .platform-enterprise-catalog .platform-search input {
+  width: 100%;
+  flex: 1;
+  padding-left: 12px;
+}
+.admin-platform .platform-enterprise-catalog .platform-search .button {
+  border: 0;
+  flex-shrink: 0;
+  color: var(--muted);
+}
+.admin-platform .platform-enterprise-catalog .platform-filters select {
+  margin-left: auto;
+}
+.admin-platform .platform-enterprise-catalog .platform-list-columns {
+  background: transparent;
+  padding-block: 10px;
+}
+.admin-platform .platform-enterprise-catalog .platform-tenant-row {
+  min-height: 64px;
+  padding-block: 16px;
+  background: transparent;
+}
+.admin-platform .platform-enterprise-catalog .platform-tenant-row:hover {
+  background: var(--soft);
+}
+.admin-platform .platform-enterprise-catalog .platform-tenant-row:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: -3px;
+}
+@media (max-width: 600px) {
+  .admin-platform .platform-enterprise-catalog .platform-list-heading {
+    padding: 16px 18px;
+  }
+  .admin-platform .platform-enterprise-catalog .platform-filters {
+    grid-template-columns: minmax(0, 1fr) auto;
+  }
+  .admin-platform .platform-enterprise-catalog .platform-search {
+    width: 100%;
+    grid-column: 1 / -1;
+  }
+  .admin-platform .platform-enterprise-catalog .platform-filters select {
+    margin-left: 0;
+  }
+}
