+
+/* 企业详情：对象信息、内容页签与按需操作。 */
+.admin-platform .platform-enterprise-redesign { margin-top: 0; padding: 0; }
+.platform-enterprise-heading { display: flex; align-items: center; gap: 14px; padding: 24px; }
+.platform-enterprise-heading-text { flex: 1; min-width: 0; }
+.platform-enterprise-heading-text h2 { margin: 0; font-size: 20px; font-weight: 600; }
+.platform-enterprise-heading-text p { margin: 6px 0 0; color: var(--muted); font-size: 13px; }
+.admin-platform .platform-detail-back { border: 1px solid var(--line); width: 36px; height: 36px; padding: 0; flex-shrink: 0; }
+.admin-platform .platform-enterprise-redesign .platform-detail-nav { margin: 0; padding: 0 24px; gap: 24px; border-bottom: 1px solid var(--line); }
+.admin-platform .platform-enterprise-redesign .platform-detail-nav .button { padding: 12px 0; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; color: var(--muted); }
+.admin-platform .platform-enterprise-redesign .platform-detail-nav .button[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }
+.platform-enterprise-redesign > .platform-facts { margin: 0; padding: 24px; grid-template-columns: 1fr 1fr 1fr; border-bottom: 1px solid var(--line); }
+.platform-enterprise-redesign > .platform-detail-section { margin: 0; padding: 20px 24px; border-top: 0; }
+.platform-invite-history > summary { display: flex; align-items: center; gap: 12px; cursor: pointer; font-weight: 550; font-size: 14px; }
+.platform-invite-history > summary::before { content: '›'; color: var(--muted); }
+.platform-invite-history[open] > summary::before { transform: rotate(90deg); }
+.platform-invite-history > summary span { margin-left: auto; font-weight: 400; font-size: 12px; color: var(--muted); }
+.admin-platform .platform-invite-history > summary { margin-bottom: 0; }
+.admin-platform .platform-invite-history[open] > summary { margin-bottom: 20px; }
+.platform-enterprise-management { padding: 20px 24px 8px; border-top: 1px solid var(--line); }
+.platform-enterprise-management h3 { font-size: 13px; color: var(--muted); font-weight: 500; margin: 0 0 8px; }
+.platform-management-row { display: flex; align-items: center; gap: 24px; padding: 16px 0; }
+.platform-management-row + .platform-management-row { border-top: 1px solid var(--line); }
+.platform-management-row > div { flex: 1; }
+.platform-management-row strong { font-size: 14px; font-weight: 550; }
+.platform-management-row p { margin: 5px 0 0; font-size: 13px; color: var(--muted); }
+.platform-enterprise-redesign > .usage-page, .platform-enterprise-redesign > .departure-status, .platform-enterprise-redesign > .platform-service-state, .platform-enterprise-redesign > .access-success { margin: 20px 24px; }
+.platform-management-modal .platform-action-target { margin: 0 0 12px; font-weight: 550; }
+.platform-management-modal .governance-section { border-top: 0; margin-top: 0; padding-top: 0; }
+.platform-management-modal fieldset { border: 0; padding: 0; margin: 16px 0; min-width: 0; }
