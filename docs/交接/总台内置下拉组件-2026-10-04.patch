diff --git ab/src/shared/Select.tsx b/src/shared/Select.tsx
new file mode 100644
index 0000000..f0c0dac
--- /dev/null
+++ b/src/shared/Select.tsx
@@ -0,0 +1,216 @@
+import {
+  createContext,
+  useContext,
+  useId,
+  useLayoutEffect,
+  useRef,
+  useState,
+  type ChangeEvent,
+  type SelectHTMLAttributes,
+} from 'react';
+import { Check, ChevronDown } from 'lucide-react';
+import './select.css';
+
+export const CustomSelectContext = createContext(false);
+type Option = { value: string; label: string; disabled: boolean };
+/** One styled control in the platform console; native form values and validation remain intact. */
+export function Select(props: SelectHTMLAttributes<HTMLSelectElement>) {
+  const custom = useContext(CustomSelectContext);
+  return custom ? <CustomSelect {...props} /> : <select {...props} />;
+}
+function CustomSelect({
+  children,
+  className = '',
+  style,
+  onChange,
+  onInvalid,
+  ...props
+}: SelectHTMLAttributes<HTMLSelectElement>) {
+  const native = useRef<HTMLSelectElement>(null);
+  const trigger = useRef<HTMLButtonElement>(null);
+  const panel = useRef<HTMLDivElement>(null);
+  const id = useId();
+  const [open, setOpen] = useState(false);
+  const [options, setOptions] = useState<Option[]>([]);
+  const [display, setDisplay] = useState('');
+  const [label, setLabel] = useState<string>();
+  const [active, setActive] = useState(0);
+  const [invalid, setInvalid] = useState(false);
+  const search = useRef({ text: '', at: 0 });
+  useLayoutEffect(() => {
+    const element = native.current!;
+    setDisplay(element.selectedOptions[0]?.text || '请选择');
+    setLabel(props['aria-label'] || element.labels?.[0]?.textContent?.trim() || undefined);
+    if (open) {
+      setOptions(
+        Array.from(element.options, (item) => ({
+          value: item.value,
+          label: item.text,
+          disabled:
+            item.disabled ||
+            (item.parentElement instanceof HTMLOptGroupElement && item.parentElement.disabled),
+        })),
+      );
+      setActive(Math.max(0, element.selectedIndex));
+    }
+  }, [children, props.value, props.defaultValue, props['aria-label'], open]);
+  useLayoutEffect(() => {
+    if (!open) return;
+    const popup = panel.current!;
+    popup.showPopover();
+    const place = () => {
+      const rect = trigger.current!.getBoundingClientRect();
+      popup.style.minWidth = `${rect.width}px`;
+      popup.style.maxWidth = `${innerWidth - 24}px`;
+      const height = popup.offsetHeight;
+      popup.style.left = `${Math.max(12, Math.min(rect.left, innerWidth - popup.offsetWidth - 12))}px`;
+      popup.style.top = `${Math.max(12, rect.bottom + height + 8 < innerHeight ? rect.bottom + 6 : rect.top - height - 6)}px`;
+    };
+    const resize = new ResizeObserver(place);
+    resize.observe(popup);
+    place();
+    const outside = (event: PointerEvent) => {
+      if (!popup.contains(event.target as Node) && !trigger.current?.contains(event.target as Node))
+        setOpen(false);
+    };
+    document.addEventListener('pointerdown', outside);
+    window.addEventListener('resize', place);
+    window.addEventListener('scroll', place, true);
+    return () => {
+      resize.disconnect();
+      popup.hidePopover();
+      document.removeEventListener('pointerdown', outside);
+      window.removeEventListener('resize', place);
+      window.removeEventListener('scroll', place, true);
+    };
+  }, [open]);
+  useLayoutEffect(() => {
+    if (open) panel.current?.querySelector(`[data-index="${active}"]`)?.scrollIntoView({ block: 'nearest' });
+  }, [active, open, options]);
+  const choose = (index: number) => {
+    const option = options[index];
+    if (!option || option.disabled) return;
+    const element = native.current!;
+    const changed = element.value !== option.value;
+    element.value = option.value;
+    setDisplay(option.label);
+    setInvalid(false);
+    setOpen(false);
+    if (changed)
+      onChange?.({
+        target: element,
+        currentTarget: element,
+        type: 'change',
+      } as ChangeEvent<HTMLSelectElement>);
+    trigger.current?.focus();
+  };
+  const move = (step: number) => {
+    for (let n = 1; n <= options.length; n++) {
+      const index = (active + step * n + options.length) % options.length;
+      if (!options[index].disabled) {
+        setActive(index);
+        break;
+      }
+    }
+  };
+  return (
+    <span className={`app-select ${className}`} style={style}>
+      <select
+        {...props}
+        ref={native}
+        className="app-select-native"
+        aria-hidden="true"
+        tabIndex={-1}
+        onChange={onChange}
+        onInvalid={(event) => {
+          event.preventDefault();
+          setInvalid(true);
+          trigger.current?.focus();
+          onInvalid?.(event);
+        }}
+      >
+        {children}
+      </select>
+      <button
+        ref={trigger}
+        type="button"
+        className="app-select-trigger"
+        role="combobox"
+        aria-label={label}
+        aria-haspopup="listbox"
+        aria-expanded={open}
+        aria-controls={open ? id : undefined}
+        aria-activedescendant={open ? `${id}-${active}` : undefined}
+        aria-invalid={invalid || undefined}
+        aria-required={props.required || undefined}
+        disabled={props.disabled}
+        onClick={() => setOpen(!open)}
+        onKeyDown={(event) => {
+          if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' '].includes(event.key)) {
+            event.preventDefault();
+            if (!open) {
+              setOpen(true);
+              return;
+            }
+            if (event.key === 'ArrowDown') move(1);
+            else if (event.key === 'ArrowUp') move(-1);
+            else if (event.key === 'Home')
+              setActive(
+                Math.max(
+                  0,
+                  options.findIndex((item) => !item.disabled),
+                ),
+              );
+            else if (event.key === 'End') setActive(options.findLastIndex((item) => !item.disabled));
+            else choose(active);
+          } else if (event.key === 'Escape' && open) {
+            event.preventDefault();
+            event.stopPropagation();
+            setOpen(false);
+          } else if (event.key === 'Tab') setOpen(false);
+          else if (open && event.key.length === 1) {
+            const now = Date.now();
+            search.current.text = (now - search.current.at > 600 ? '' : search.current.text) + event.key;
+            search.current.at = now;
+            const index = options.findIndex(
+              (item) =>
+                !item.disabled && item.label.toLowerCase().startsWith(search.current.text.toLowerCase()),
+            );
+            if (index >= 0) setActive(index);
+          }
+        }}
+      >
+        <span>{display}</span>
+        <ChevronDown size={14} aria-hidden="true" />
+      </button>
+      {open && (
+        <div
+          ref={panel}
+          popover="manual"
+          className="app-select-popup"
+          role="listbox"
+          id={id}
+          aria-label={label}
+        >
+          {options.map((option, index) => (
+            <div
+              key={`${option.value}-${index}`}
+              role="option"
+              id={`${id}-${index}`}
+              data-index={index}
+              aria-selected={native.current?.value === option.value}
+              aria-disabled={option.disabled || undefined}
+              className={`app-select-option ${index === active ? 'highlighted' : ''}`}
+              onPointerMove={() => !option.disabled && setActive(index)}
+              onPointerDown={(event) => event.preventDefault()}
+              onClick={() => choose(index)}
+            >
+              <span>{option.label}</span>
+              {native.current?.value === option.value && <Check size={15} aria-hidden="true" />}
+            </div>
+          ))}
+        </div>
+      )}
+    </span>
+  );
+}
diff --git ab/src/shared/select.css b/src/shared/select.css
new file mode 100644
index 0000000..0121341
--- /dev/null
+++ b/src/shared/select.css
@@ -0,0 +1,99 @@
+.app-select {
+  display: inline-flex;
+  position: relative;
+  min-width: 0;
+  vertical-align: middle;
+}
+.app-select-native {
+  position: absolute;
+  opacity: 0;
+  pointer-events: none;
+  width: 1px !important;
+  height: 1px !important;
+  padding: 0 !important;
+}
+.admin-platform .app-select-trigger {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  min-height: 36px;
+  width: 100%;
+  padding: 8px 12px;
+  border: 1px solid var(--border, #e4e9f0);
+  border-radius: var(--radius, 8px);
+  background: var(--surface, #fff);
+  color: var(--text, #2d3744);
+  font: inherit;
+  font-size: 13px;
+  text-align: left;
+  cursor: pointer;
+}
+.app-select-trigger > span {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.app-select-trigger > svg {
+  flex-shrink: 0;
+  color: #64748b;
+}
+.admin-platform .app-select-trigger:hover {
+  border-color: #a9bbd4;
+}
+.admin-platform .app-select-trigger:focus-visible,
+.admin-platform .app-select-trigger[aria-expanded='true'] {
+  outline: 2px solid #c5d9fc;
+  outline-offset: 1px;
+  border-color: #3373df;
+}
+.app-select-trigger:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+.app-select-popup {
+  position: fixed;
+  inset: auto;
+  margin: 0;
+  padding: 5px;
+  max-height: min(320px, calc(100vh - 24px));
+  overflow-y: auto;
+  border: 1px solid #e1e7f0;
+  border-radius: 10px;
+  background: #fff;
+  color: #2d3744;
+  box-shadow: 0 8px 28px #1e355b20;
+  font:
+    13px/1.5 -apple-system,
+    BlinkMacSystemFont,
+    'PingFang SC',
+    'Microsoft YaHei',
+    sans-serif;
+}
+.app-select-option {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 8px 10px;
+  border-radius: 6px;
+  cursor: pointer;
+}
+.app-select-option.highlighted {
+  background: #f1f5fc;
+}
+.app-select-option[aria-selected='true'] {
+  color: #175bb7;
+  background: #e8f0ff;
+}
+.app-select-option[aria-disabled='true'] {
+  opacity: 0.45;
+  cursor: default;
+}
+.admin-platform .field .app-select {
+  display: flex;
+  width: 100%;
+}
+.admin-platform .platform-enterprise-catalog .platform-filters > .app-select {
+  margin-left: auto;
+}
