# Inject into the process environment; Spring Boot does not automatically load this file.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/dreamcore_local
DATABASE_USER=dreamcore_local
DATABASE_PASSWORD=replace-in-private-environment
# Local development only. Default profile requires Secure cookies and disables invitations.
SPRING_PROFILES_ACTIVE=local
INVITATION_OUTBOX=./.local/invitations
# Bootstrap uses an owner-only password file, never a password CLI argument.
# BOOTSTRAP_EMAIL=admin@example.test
# BOOTSTRAP_PASSWORD_FILE=/absolute/path/to/owner-only-password

# Private originals adapter (POSIX): an explicit dedicated 0700 directory; absent => uploads return 503.
# MATERIAL_STORAGE_ROOT=/absolute/path/to/this-workspace-private-objects
# MATERIAL_MAX_BYTES=20971520

# Optional local macOS parser (trusted absolute worker path, no cloud models)
KNOWLEDGE_ENABLED=false
KNOWLEDGE_PARSER_ROOT=

# Agent remains off until the model/data scope and budget are configured explicitly.
TASK_ENABLED=false
TASK_ENGINE_TOKEN=
AGENT_TASK_MODE=off
# ENGINE_BASE_URL=http://127.0.0.1:18182

# Public queries must be explicitly entered by the user; engine must opt in too.
AGENT_PUBLIC_WEB_ENABLED=false

# Transitional opt-in ONLY when retaining the verified 0.9.0 rollback artifact.
# Current engines advertise task protocols; keep this false after the transition.
ENGINE_LEGACY_090_ENABLED=false
