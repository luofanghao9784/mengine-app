{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamcore.local/contracts/engine-api/conversation-title.schema.json",
  "description": "POST /internal/v1/conversation-title. Authenticated independent auxiliary request; no tools, no business task state changes. Null title retains fallback. Request ID is never automatically replayed.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "contractVersion",
        "conversationId",
        "requestId",
        "prompt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 32
        },
        "modelName": {
          "type": "string",
          "maxLength": 80
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "contractVersion",
        "conversationId",
        "requestId",
        "title",
        "modelName",
        "inputTokens",
        "outputTokens"
      ],
      "additionalProperties": false
    }
  ]
}
