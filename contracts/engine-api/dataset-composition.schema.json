{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamcore:dataset-composition:1.0",
  "$comment": "Capability datasetCompositionVersion=1.0; same authorized compare-dataset endpoint. One category, nonnegative SUM or COUNT, full pinned snapshot. Exact category sum equals total; platform calculates sharePercent rounded half-up to 6 decimal places. Zero total omits shares and delivery returns NO_NEW_CONTENT. Never accepts model shares. Timezone defaults Asia/Shanghai; date bounds inclusive; missingDates defaults FAIL. Current attempt/source permission and provenance are required.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "snapshotId",
        "operation",
        "groupColumns"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "format": "uuid"
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "const": "COMPOSITION"
        },
        "groupColumns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "valueColumn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "aggregation": {
          "enum": [
            "SUM",
            "COUNT"
          ]
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "dateColumn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "dateFrom": {
          "type": "string",
          "format": "date"
        },
        "dateTo": {
          "type": "string",
          "format": "date"
        },
        "missingDates": {
          "enum": [
            "FAIL",
            "EXCLUDE"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "aggregation": {
                "const": "COUNT"
              }
            },
            "required": [
              "aggregation"
            ]
          },
          "else": {
            "required": [
              "valueColumn"
            ]
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "datasetId": {
          "type": "string",
          "format": "uuid"
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "coverageThrough": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "datasetId",
        "snapshotId",
        "version",
        "name",
        "sha256",
        "rowCount",
        "collectedAt",
        "coverageThrough"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "value",
        "records"
      ],
      "properties": {
        "group": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9]{1,64}(?:\\.[0-9]{1,12})?$"
        },
        "records": {
          "type": "integer",
          "minimum": 1
        },
        "sharePercent": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,64}(?:\\.[0-9]{1,12})?$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipeVersion",
        "status",
        "request",
        "inputSha256",
        "matchedRows",
        "ignoredRows",
        "missingDateRows",
        "rows",
        "total"
      ],
      "properties": {
        "recipeVersion": {
          "const": "dataset-composition-1"
        },
        "status": {
          "const": "COMPUTED"
        },
        "request": {
          "type": "object"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "matchedRows": {
          "type": "integer",
          "minimum": 1
        },
        "ignoredRows": {
          "type": "integer",
          "minimum": 0
        },
        "missingDateRows": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group",
              "value",
              "records"
            ],
            "properties": {
              "group": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "value": {
                "type": "string",
                "pattern": "^[0-9]{1,64}(?:\\.[0-9]{1,12})?$"
              },
              "records": {
                "type": "integer",
                "minimum": 1
              },
              "sharePercent": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{1,64}(?:\\.[0-9]{1,12})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "total": {
          "type": "string",
          "pattern": "^[0-9]{1,64}(?:\\.[0-9]{1,12})?$"
        }
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1.0"
        },
        "status": {
          "const": "COMPUTED"
        },
        "datasetSource": {
          "$ref": "#/$defs/source"
        },
        "calculation": {
          "$ref": "#/$defs/calculation"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "filename": {
              "type": "string",
              "pattern": "^dataset-comparison-[a-f0-9]{20}\\.json$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          },
          "required": [
            "id",
            "filename",
            "sha256",
            "bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contractVersion",
        "status",
        "datasetSource",
        "calculation",
        "artifact"
      ],
      "additionalProperties": false
    }
  }
}
