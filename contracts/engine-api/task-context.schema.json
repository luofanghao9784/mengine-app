{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamcore:task-context:1.0",
  "description": "POST /internal/v1/agent-access/{task}/context. Live attempt Bearer only. Responses <= 57344 UTF-8 bytes; bootstrap <=24576. Bootstrap includes organization {name, source: CURRENT_TENANT, authority: false}, derived only from the authorized task tenant; it is a display name, not legal-entity evidence or broader permission. Data is never authorization. Bodies are exact-version pages; use records model-reported selection with applicationOutcome UNKNOWN. No automatic calls when check omits contextVersion or agentTask is 1.4. Dataset actions are opt-in only when check advertises datasetContextVersion=1.0. Search pins up to 3 authorized snapshots; reads return at most 5 exact rows and explicit pagination. Selected-files-only tasks cannot read datasets. System briefing batches may additionally expose only their fixed selectedDatasets; they never gain access to other datasets. New current snapshots do not replace a task pin; revocation/withdrawal/erasure invalidate downstream content. Dataset rows and columns both paginate: columnOffset defaults 0, columnLimit defaults 5 (1..10); follow source.nextColumnOffset. Oversized row pages fail explicitly; callers can reduce columnLimit to 1. No cell values are truncated. General actions are advertised only with generalExperienceVersion=1.0; read returns at most 3 complete steps per page. Fully read exact methods and an applicability check are required before DIRECT/ADAPTED selection. ADAPTED requires explicit adjustments. Selection remains MODEL_REPORTED with UNKNOWN business outcome. Only cleaned methods cross enterprises. Source erasure propagates to derived tasks; stop/re-enable never revives a fenced in-flight attempt.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "bootstrap",
            "profiles",
            "profile_read",
            "history",
            "experience_search",
            "experience_read",
            "experience_use",
            "dataset_search",
            "dataset_read",
            "general_experience_search",
            "general_experience_read",
            "general_experience_use"
          ]
        },
        "scope": {
          "enum": [
            "TENANT",
            "WORKSPACE",
            "PERSONAL"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "referenceId": {
          "type": "string",
          "format": "uuid"
        },
        "versionId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "enum": [
            "DIRECT",
            "ADAPTED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "conditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "adjustments": {
          "type": "string",
          "maxLength": 1000
        },
        "columnOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "columnLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "profiles"
              }
            }
          },
          "then": {
            "required": [
              "scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "profile_read"
              }
            }
          },
          "then": {
            "required": [
              "referenceId",
              "revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "experience_search",
                  "general_experience_search"
                ]
              }
            }
          },
          "then": {
            "required": [
              "query"
            ],
            "properties": {
              "query": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "experience_read",
                  "experience_use",
                  "general_experience_read",
                  "general_experience_use"
                ]
              }
            }
          },
          "then": {
            "required": [
              "referenceId",
              "versionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "experience_use",
                  "general_experience_use"
                ]
              }
            }
          },
          "then": {
            "required": [
              "requestId",
              "decision",
              "conditions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "profiles",
                  "history",
                  "experience_search",
                  "general_experience_search"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "offset": {
                "maximum": 1000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "dataset_read"
              }
            }
          },
          "then": {
            "required": [
              "referenceId",
              "versionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "experience_read"
              }
            }
          },
          "then": {
            "properties": {
              "offset": {
                "maximum": 8001
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_read"
              }
            }
          },
          "then": {
            "properties": {
              "offset": {
                "maximum": 9
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_use"
              },
              "decision": {
                "const": "ADAPTED"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "adjustments"
            ],
            "properties": {
              "adjustments": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_search"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "action",
                "query",
                "offset"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_read"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "action",
                "referenceId",
                "versionId",
                "offset"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_use"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "action",
                "referenceId",
                "versionId",
                "requestId",
                "decision",
                "conditions",
                "adjustments"
              ]
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "action",
        "referenceOnly",
        "result"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0"
        },
        "action": {
          "enum": [
            "bootstrap",
            "profiles",
            "profile_read",
            "history",
            "experience_search",
            "experience_read",
            "experience_use",
            "dataset_search",
            "dataset_read",
            "general_experience_search",
            "general_experience_read",
            "general_experience_use"
          ]
        },
        "referenceOnly": {
          "const": true
        },
        "result": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_search"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/generalSearch"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_read"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/generalRead"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "general_experience_use"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/generalUse"
              }
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "executionClass",
        "publicQuery",
        "candidateTrialsAllowed"
      ],
      "properties": {
        "allowed": {
          "const": true
        },
        "executionClass": {
          "enum": [
            "verification",
            "live"
          ]
        },
        "publicQuery": {
          "type": "string",
          "maxLength": 2048
        },
        "candidateTrialsAllowed": {
          "type": "boolean"
        },
        "contextVersion": {
          "const": "1.0"
        },
        "taskWorkVersion": {
          "const": "1.0"
        },
        "planAllowed": {
          "type": "boolean"
        },
        "tableComparisonVersion": {
          "enum": [
            "",
            "1.0"
          ]
        },
        "briefingContentVersion": {
          "const": "1.0"
        },
        "planManagementVersion": {
          "const": "1.0"
        },
        "briefingGeneration": {
          "type": "boolean",
          "description": "Platform-owned generation batch; reserves a short final confirmation without increasing total task budget."
        },
        "datasetContextVersion": {
          "const": "1.0"
        },
        "generalExperienceVersion": {
          "const": "1.0"
        }
      }
    },
    "generalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "versionId",
        "number",
        "title",
        "summary",
        "tags",
        "authority"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "format": "uuid"
        },
        "versionId": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "authority": {
          "const": false
        }
      }
    },
    "generalSearch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "hasMore",
            "scope",
            "applicationOutcome"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/generalSummary"
              }
            },
            "hasMore": {
              "type": "boolean"
            },
            "scope": {
              "const": "GENERAL_CLEANED"
            },
            "applicationOutcome": {
              "const": "UNKNOWN"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "hasMore",
            "reason"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 0
            },
            "hasMore": {
              "const": false
            },
            "reason": {
              "const": "SELECTED_ONLY"
            }
          }
        }
      ]
    },
    "generalUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unavailable",
        "reason"
      ],
      "properties": {
        "unavailable": {
          "const": true
        },
        "reason": {
          "const": "SELECTED_ONLY"
        }
      }
    },
    "generalRead": {
      "oneOf": [
        {
          "$ref": "#/$defs/generalUnavailable"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entryId",
            "versionId",
            "number",
            "title",
            "summary",
            "tags",
            "authority",
            "steps",
            "offset",
            "nextOffset",
            "totalSteps",
            "applicable",
            "excluded",
            "basis",
            "requiresApplicabilityCheck"
          ],
          "properties": {
            "entryId": {
              "type": "string",
              "format": "uuid"
            },
            "versionId": {
              "type": "string",
              "format": "uuid"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "authority": {
              "const": false
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "nextOffset": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9
            },
            "totalSteps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "applicable": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "excluded": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "basis": {
              "enum": [
                "OBSERVED_EXECUTION",
                "FEEDBACK_CORRECTION"
              ]
            },
            "requiresApplicabilityCheck": {
              "const": true
            }
          }
        }
      ]
    },
    "generalUse": {
      "oneOf": [
        {
          "$ref": "#/$defs/generalUnavailable"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "versionId",
            "attempt",
            "decision",
            "conditions",
            "adjustments",
            "selectionRecorded",
            "assessmentSource",
            "applicationOutcome",
            "businessActionPerformed"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "versionId": {
              "type": "string",
              "format": "uuid"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "decision": {
              "enum": [
                "DIRECT",
                "ADAPTED",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "conditions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "adjustments": {
              "type": "string",
              "maxLength": 1000
            },
            "selectionRecorded": {
              "type": "boolean"
            },
            "assessmentSource": {
              "const": "MODEL_REPORTED"
            },
            "applicationOutcome": {
              "const": "UNKNOWN"
            },
            "businessActionPerformed": {
              "const": false
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "decision": {
                    "enum": [
                      "DIRECT",
                      "ADAPTED"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "selectionRecorded": {
                    "const": true
                  }
                }
              },
              "else": {
                "properties": {
                  "selectionRecorded": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "decision": {
                    "const": "ADAPTED"
                  }
                }
              },
              "then": {
                "properties": {
                  "adjustments": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
