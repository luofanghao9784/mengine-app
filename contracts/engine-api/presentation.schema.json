{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamcore:presentation:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "theme",
    "slides"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "theme": {
      "type": "string",
      "enum": [
        "ocean",
        "ink"
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "sourceIds"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cover",
              "bullets",
              "table",
              "chart"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "sourceIds": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 90,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "headers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          },
          "labels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "series": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    }
  }
}
