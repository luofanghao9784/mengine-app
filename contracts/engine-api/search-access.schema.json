{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamcore:search-access:1.0",
  "description": "Additive /agent-access/{task}/search response. Maximum encoded response 60 KiB, inside the existing 64 KiB transport cap.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string",
            "maxLength": 180
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "locator": {
            "type": "string",
            "maxLength": 180
          },
          "content": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "filename",
          "version",
          "locator",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "matchStatus": {
      "enum": [
        "MATCHED",
        "NO_MATCH"
      ]
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "matchStatus",
    "coverage",
    "hasMore"
  ],
  "additionalProperties": false,
  "$defs": {
    "coverage": {
      "type": "object",
      "description": "Only currently authorized scope is counted. Unparsed files have unknown query relevance. Version details are bounded separately from result pagination.",
      "properties": {
        "scope": {
          "enum": [
            "AUTHORIZED_WORKSPACE",
            "AUTHORIZED_SHARED",
            "SELECTED_VERSIONS"
          ]
        },
        "status": {
          "enum": [
            "EMPTY",
            "READY",
            "PARTIAL",
            "NOT_READY"
          ]
        },
        "relevance": {
          "const": "NOT_ASSESSED"
        },
        "versions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/versionCoverage"
          }
        },
        "hasMore": {
          "type": "boolean"
        },
        "totalVersions": {
          "type": "integer",
          "minimum": 0
        },
        "searchableVersions": {
          "type": "integer",
          "minimum": 0
        },
        "partialVersions": {
          "type": "integer",
          "minimum": 0
        },
        "notReadyVersions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "scope",
        "status",
        "relevance",
        "versions",
        "hasMore",
        "totalVersions",
        "searchableVersions",
        "partialVersions",
        "notReadyVersions"
      ],
      "additionalProperties": false
    },
    "versionCoverage": {
      "type": "object",
      "properties": {
        "materialId": {
          "type": "string",
          "format": "uuid"
        },
        "versionId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "QUEUED",
            "RUNNING",
            "READY",
            "PARTIAL",
            "FAILED",
            "UNSUPPORTED",
            "CANCELLED"
          ]
        },
        "warnings": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "required": [
        "materialId",
        "versionId",
        "version",
        "runId",
        "generation",
        "status",
        "warnings",
        "pinned"
      ],
      "additionalProperties": false
    }
  }
}
