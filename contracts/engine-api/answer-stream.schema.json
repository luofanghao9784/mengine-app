{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamcore:answer-stream:1.0",
  "description": "check 的可选 answerStreamVersion=1.0 启用 POST /internal/v1/agent-access/{task}/answer；Bearer 为当前执行租约。step 为模型调用轮序，version 在该 step 内递增。同版本相同内容幂等，文字仅可追加，COMPLETE 后不可修改。旧租约、停止或撤权拒绝写入；返回 {accepted:true}。旧平台未声明时不回调。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step",
    "version",
    "text",
    "state"
  ],
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "state": {
      "enum": [
        "STREAMING",
        "COMPLETE"
      ]
    }
  }
}
