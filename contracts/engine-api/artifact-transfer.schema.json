{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamcore:artifact-transfer:1.0",
  "$defs": {
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientKey": {
          "type": "string",
          "format": "uuid"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "mediaType": {
          "enum": [
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "text/html",
            "application/json",
            "image/png",
            "image/jpeg",
            "text/markdown",
            "text/plain",
            "text/csv",
            "application/zip",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "clientKey",
        "filename",
        "mediaType",
        "bytes",
        "sha256"
      ]
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20971519
        },
        "contentBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 349528
        }
      },
      "required": [
        "offset",
        "contentBase64"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0"
        },
        "uploadId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "UPLOADING",
            "READY",
            "PUBLISHED"
          ]
        },
        "receivedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20971520
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "chunkBytes": {
          "const": 262144
        }
      },
      "required": [
        "contractVersion",
        "uploadId",
        "state",
        "receivedBytes",
        "bytes",
        "sha256",
        "chunkBytes"
      ]
    }
  }
}
