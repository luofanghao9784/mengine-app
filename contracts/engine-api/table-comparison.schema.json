{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamcore:table-comparison:1.0",
  "$comment": "POST /internal/v1/agent-access/{task}/compare-table; active attempt bearer; no-store; fixed table-compare-1 recipe. Numerical strings preserve decimal precision.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "range": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,4}:[A-Z]{1,2}[1-9][0-9]{0,4}$"
        },
        "groupColumn": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}$"
        },
        "periodColumn": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}$"
        },
        "valueColumn": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}$"
        },
        "baseline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "current": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "sourceId",
        "sheet",
        "range",
        "groupColumn",
        "periodColumn",
        "valueColumn",
        "baseline",
        "current"
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contractVersion": {
              "const": "1.0"
            },
            "status": {
              "const": "COMPUTED"
            },
            "source": {
              "type": "object",
              "required": [
                "id",
                "versionId",
                "sha256"
              ]
            },
            "calculation": {
              "type": "object",
              "required": [
                "recipeVersion",
                "request",
                "rows",
                "totals",
                "inputSha256"
              ],
              "properties": {
                "recipeVersion": {
                  "const": "table-compare-1"
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50
                }
              }
            },
            "artifact": {
              "type": "object",
              "required": [
                "id",
                "filename",
                "sha256",
                "bytes"
              ]
            }
          },
          "required": [
            "contractVersion",
            "status",
            "source",
            "calculation",
            "artifact"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contractVersion": {
              "const": "1.0"
            },
            "status": {
              "const": "FAILED"
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z_]+(?::[A-Z]{1,2}[0-9]{1,5})?$"
            }
          },
          "required": [
            "contractVersion",
            "status",
            "code"
          ]
        }
      ]
    }
  }
}
