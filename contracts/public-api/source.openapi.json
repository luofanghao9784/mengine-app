          "description",
          "responsibleId",
          "cadenceHours",
          "expectedFrom",
          "expectedThrough",
          "status",
          "id",
          "tenantId",
          "workspaceId",
          "revision",
          "coverageState",
          "lastSubmittedAt",
          "dueAt",
          "overdue",
          "canMaintain",
          "updatedAt"
