  "components": {
    "schemas": {
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "awaiting_human",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "QualityVerdict": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "pending"
        ],
        "description": "定稿含 pending；≠ admissionTestVerdict"
      },
      "ExecutionMode": {
        "type": "string",
        "enum": [
          "simulated",
          "real"
        ]
      },
      "IssueKind": {
        "type": "string",
        "enum": [
          "unit_mix",
          "date_ambiguous",
          "missing_business_key",
          "conflict_duplicate",
          "other"
        ]
      },
      "QualityIssueEvidence": {
        "type": "object",
        "required": [
          "inputVersionId"
        ],
        "properties": {
          "inputVersionId": {
            "type": "string"
          },
          "row": {
            "type": "integer"
          },
          "column": {
            "type": "string",
            "description": "定稿 column（非 field）"
          }
        },
        "additionalProperties": false
      },
      "QualityIssue": {
        "type": "object",
        "required": [
          "issueId",
          "kind",
          "qualityVerdict",
          "summary"
        ],
        "properties": {
          "issueId": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/IssueKind"
          },
          "qualityVerdict": {
            "$ref": "#/components/schemas/QualityVerdict"
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/QualityIssueEvidence"
          },
          "rawValue": {
            "type": "string"
          },
          "proposedValue": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CheckDebugRun": {
        "type": "object",
        "required": [
          "debugRunId",
          "tenantId",
          "inputVersionId",
          "moduleVersionId",
          "executionMode",
          "runStatus"
        ],
        "properties": {
          "debugRunId": {
            "type": "string",
            "description": "定稿主键；≠ runId"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "spaceId": {
            "type": "string"
          },
          "inputVersionId": {
            "type": "string"
          },
          "capabilityId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "configVersionId": {
            "type": "string"
          },
          "executionMode": {
            "$ref": "#/components/schemas/ExecutionMode"
          },
          "runStatus": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "qualityVerdict": {
            "$ref": "#/components/schemas/QualityVerdict"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QualityIssue"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usage": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": "string"
          },
          "evidenceComplete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "无 publishStatus；不可发布"
      },
      "CheckDebugRunCreate": {
        "type": "object",
        "required": [
          "inputVersionId",
          "moduleVersionId",
          "executionMode"
        ],
        "properties": {
          "spaceId": {
            "type": "string"
          },
          "inputVersionId": {
            "type": "string"
          },
          "capabilityId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "configVersionId": {
            "type": "string"
          },
          "executionMode": {
            "$ref": "#/components/schemas/ExecutionMode"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
