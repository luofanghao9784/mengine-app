        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      }
    },
    "parameters": {
      "Tenant": {
        "name": "tenant",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "CsrfHeader": {
        "name": "X-CSRF-TOKEN",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 20
        }
      }
    },
    "schemas": {
      "ExportSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "version", "format"],
        "properties": {
          "objectId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "type": "string",
            "enum": ["docx", "pdf"]
          }
        }
      },
      "ExportChoice": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selection", "versionId", "title", "sizeBytes", "createdAt"],
        "properties": {
          "selection": {
            "$ref": "#/components/schemas/ExportSelection"
          },
          "versionId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": -1,
            "maximum": 2097152
          },
