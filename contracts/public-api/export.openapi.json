    "/api/v1/tenants/{tenant}/export-batches/{id}/archive": {
      "get": {
        "summary": "Recheck every included item and source, verify checksum, then stream ZIP",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Actual ZIP with selected files and _export-manifest.json. Partial export contains failure reasons. Never a successful empty archive.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 41943040
                }
              },
              "X-Content-SHA256": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
