{
  "openapi": "3.1.0",
  "info": {
    "title": "Bounded owner-only export batches",
    "version": "1.0.0",
    "description": "Explicit BULK_EXPORT plus current object/source read permissions at selection, per-item generation, finalization and download. Private documents remain source-bound; independent enterprise publications only follow target material permissions. 64KiB server chunks, 2MiB per item, 32MiB included content, 40MiB archive, 50 selections. TTL is chosen from advertised 1/3/7 days, default UI 7 if supported; reads/retries never extend an existing deadline. Expired chunks are deleted online with separate cleanup receipts. Packages are not full migrations/system backups; downloaded copies and old backups are outside online cleanup."
  },
