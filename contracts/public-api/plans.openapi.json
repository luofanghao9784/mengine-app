{
  "openapi": "3.1.0",
  "info": {
    "title": "Dreamcore Personal Ongoing Plans",
    "version": "1.0.0",
    "description": "本人明确委托；模型关闭保留等待不造任务。次数/节奏限制不是费用硬上限。每日采用IANA时区；DST缺时顺延首个有效时刻、重复时只取较早一次。错过日期合并当前核查并记录missedSlots，资料版本事实去重。"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant}/plans": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "本人且当前范围可读的计划",
        "responses": {
          "200": {
            "description": "当前权限复核后的实际持久状态；private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "401": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "403": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "404": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "409": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      },
      "post": {
        "summary": "保存草案，不隐式启动",
        "responses": {
          "201": {
            "description": "当前权限复核后的实际持久状态；private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "401": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "403": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "404": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          },
          "409": {
            "description": "身份/范围/输入/版本或执行条件不满足"
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create"
              }
            }
          }
        }
      }
    },
