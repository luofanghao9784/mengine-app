  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      }
    },
    "schemas": {
      "Configuration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspaceId",
          "goal",
          "purpose",
          "query",
          "behavior",
          "materialEvents",
          "dailyTime",
          "timeZone",
          "minIntervalSeconds",
          "maxRunsPerDay",
          "maxTotalRuns",
          "expiresAt",
          "notificationsEnabled"
        ],
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "behavior": {
            "enum": [
              "SOURCE_LOOKUP",
              "ANALYZE"
            ]
          },
          "materialEvents": {
            "type": "boolean"
          },
          "dailyTime": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "timeZone": {
            "type": "string"
          },
          "minIntervalSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "maxRunsPerDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "maxTotalRuns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "notificationsEnabled": {
            "type": "boolean"
          }
        }
      },
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenantId",
          "ownerId",
          "revision",
          "executionEpoch",
          "status",
          "runtimeState",
          "reason",
          "configuration",
          "nextDue",
          "lastDispatchedAt",
          "runs",
          "todayRuns",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "executionEpoch": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "DRAFT",
              "ACTIVE",
              "PAUSED",
              "STOPPED",
              "EXPIRED",
              "AUTHORIZATION_REQUIRED"
            ]
          },
          "runtimeState": {
            "enum": [
              "IDLE",
              "WAITING_TIME",
              "WAITING_DATA",
              "WAITING_CAPABILITY",
              "WAITING_RESOURCE",
              "RUNNING",
              "NEEDS_ATTENTION"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "configuration": {
            "$ref": "#/components/schemas/Configuration"
          },
          "nextDue": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastDispatchedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "todayRuns": {
            "type": "integer",
            "minimum": 0
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Plan"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "planId",
          "planRevision",
          "executionEpoch",
          "triggerKind",
          "scheduledFor",
          "missedSlots",
          "eventThrough",
          "sourceVersions",
          "conversationId",
          "taskId",
          "status",
          "errorCode",
          "createdAt",
          "finishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "planRevision": {
            "type": "integer",
            "minimum": 1
          },
          "executionEpoch": {
            "type": "integer",
            "minimum": 0
          },
          "triggerKind": {
            "enum": [
              "MATERIAL_VERSION",
              "DAILY",
              "RETRY"
            ]
          },
          "scheduledFor": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "missedSlots": {
            "type": "integer",
            "minimum": 0
          },
          "eventThrough": {
            "type": "integer",
            "minimum": 0
          },
          "sourceVersions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "materialId",
                "versionId",
                "parseStatus"
              ],
              "properties": {
                "materialId": {
                  "type": "string",
                  "format": "uuid"
                },
                "versionId": {
                  "type": "string",
                  "format": "uuid"
                },
                "parseStatus": {
                  "type": "string"
                }
              }
            }
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Runs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Run"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "configuration"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "configuration": {
            "$ref": "#/components/schemas/Configuration"
          }
        }
      },
      "Update": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "configuration"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "configuration": {
            "$ref": "#/components/schemas/Configuration"
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "action",
          "delegationAccepted"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "enum": [
              "ENABLE",
              "PAUSE",
              "RESUME",
              "STOP",
              "RETRY",
              "MUTE",
              "UNMUTE"
            ]
          },
          "delegationAccepted": {
            "type": "boolean"
          }
        }
      },
      "Attention": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspaceId",
          "title",
          "reason",
          "status",
          "revision",
          "taskId",
          "conversationId",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "taskId": {
