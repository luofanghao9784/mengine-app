{
  "openapi": "3.1.0",
  "info": {
    "title": "检查运行记录（check-run-log）",
    "version": "0.0.0-skeleton",
    "description": "【骨架 · 后端未实现 · 勿当 Live】CT-031 OpenAPI 提纲占位（表面 tenant-admin）。字段/枚举对齐 docs/architecture/契约分片-检查与能力.md 与 ADR-B8 D8-5；响应以 501 占位；禁止当作已实现 API 或假 Live 业务数据。"
  },
  "paths": {
    "/api/tenant-admin/v1/quality-ops/check-tasks": {
      "get": {
        "operationId": "listCheckTasks",
        "summary": "列出真检查任务（骨架）",
        "tags": [
          "quality-ops"
        ],
        "responses": {
          "200": {
            "description": "骨架占位 · 未实现",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CheckTask"
                  }
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCheckTask",
        "summary": "创建检查任务（骨架）",
        "tags": [
          "quality-ops"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckTaskCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "同步规则检查已完成；结论仅在本次响应返回。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "taskId",
                    "status",
                    "result"
                  ],
                  "properties": {
                    "taskId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "const": "COMPLETED"
                    },
                    "result": {
                      "type": "object",
                      "required": [
                        "verdict",
                        "issues"
                      ],
                      "properties": {
                        "verdict": {
                          "type": "string",
                          "enum": [
                            "NO_ISSUES",
                            "ISSUES_FOUND"
                          ]
                        },
                        "issues": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "message"
                            ],
                            "properties": {
                              "message": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "verdict": {
                                "const": "ISSUES_FOUND"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "issues": {
                                "minItems": 1
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "verdict": {
                                "const": "NO_ISSUES"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "issues": {
                                "maxItems": 0
                              }
                            }
                          }
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenant-admin/v1/quality-ops/check-tasks/{taskId}": {
      "get": {
        "operationId": "getCheckTask",
