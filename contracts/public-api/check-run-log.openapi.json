  "components": {
    "schemas": {
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "awaiting_human",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "QualityVerdict": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "pending"
        ],
        "description": "定稿含 pending；≠ admissionTestVerdict"
      },
      "PublishStatus": {
        "type": "string",
        "enum": [
          "unpublished",
          "published",
          "superseded"
        ]
      },
      "ExecutionMode": {
        "type": "string",
        "enum": [
          "simulated",
          "real"
        ]
      },
      "IssueKind": {
        "type": "string",
        "enum": [
          "unit_mix",
          "date_ambiguous",
          "missing_business_key",
          "conflict_duplicate",
          "other"
        ]
      },
      "CheckStage": {
        "type": "string",
        "enum": [
          "ingest",
          "parse",
          "quality-check",
          "review",
          "publish"
        ]
      },
      "QualityIssueEvidence": {
        "type": "object",
        "required": [
          "inputVersionId"
        ],
        "properties": {
          "inputVersionId": {
            "type": "string"
          },
          "row": {
            "type": "integer"
          },
          "column": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "QualityIssue": {
        "type": "object",
        "required": [
          "issueId",
          "kind",
          "qualityVerdict",
          "summary"
        ],
        "properties": {
          "issueId": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/IssueKind"
          },
          "qualityVerdict": {
            "$ref": "#/components/schemas/QualityVerdict"
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/QualityIssueEvidence"
          },
          "rawValue": {
            "type": "string"
          },
          "proposedValue": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CheckTask": {
        "type": "object",
        "required": [
          "taskId",
          "tenantId",
          "inputVersionId",
          "configVersionId",
          "lockedConfigVersionId",
          "runStatus",
          "qualityVerdict",
          "publishStatus",
          "executionMode",
          "stage"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "spaceId": {
            "type": "string"
          },
          "inputVersionId": {
            "type": "string"
          },
          "configVersionId": {
            "type": "string"
          },
          "lockedConfigVersionId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "runStatus": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "qualityVerdict": {
            "$ref": "#/components/schemas/QualityVerdict"
          },
          "publishStatus": {
            "$ref": "#/components/schemas/PublishStatus"
          },
          "executionMode": {
            "$ref": "#/components/schemas/ExecutionMode"
          },
          "stage": {
            "$ref": "#/components/schemas/CheckStage"
          },
          "openIssueCount": {
            "type": "integer",
            "minimum": 0
          },
          "failedStep": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "additionalProperties": true
          },
          "isStale": {
            "type": "boolean",
            "description": "任务级过期提示；独立布尔，不进三态枚举"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "三态分列：runStatus / qualityVerdict / publishStatus；succeeded+fail → unpublished"
      },
      "CheckTaskCreate": {
        "type": "object",
        "required": [
          "inputVersionId",
          "configVersionId",
          "executionMode"
        ],
        "properties": {
          "spaceId": {
            "type": "string"
          },
          "inputVersionId": {
            "type": "string"
          },
          "configVersionId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "executionMode": {
            "$ref": "#/components/schemas/ExecutionMode"
          }
        },
        "additionalProperties": false
      },
      "CheckAttempt": {
        "type": "object",
        "required": [
          "attemptId",
          "taskId",
          "lockedConfigVersionId"
        ],
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "lockedConfigVersionId": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "retryOf": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
