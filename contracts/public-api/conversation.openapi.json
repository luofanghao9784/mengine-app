{
  "openapi": "3.1.0",
  "info": {
    "title": "Dreamcore Private Conversation API",
    "version": "1.5.0",
    "description": "私人会话及可恢复任务。SOURCE_LOOKUP 可独立运行；模型关闭时 AGENT 保存为等待能力，不自动重试。执行区分 verification 联调与 live 模型，支持等待输入、暂停恢复、部分结果、未知结果核对及分次历史。事件轮询，不承诺 token 流。来源、回复、下载均重新检查当前权限，成果不自动共享。"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant}/conversations": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "列出本人当前仍有权访问的私人会话",
        "responses": {
          "200": {
            "description": "经当前权限校验，Cache-Control: private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "无效格式、模式或参数"
          },
          "401": {
            "description": "需要登录"
          },
          "403": {
            "description": "企业不可用、无成员权限或 CSRF 拒绝"
          },
          "404": {
            "description": "会话不存在、非本人或空间已撤权"
          },
          "409": {
            "description": "请求键冲突、任务版本变化或已有运行任务"
          },
          "503": {
            "description": "执行服务未启用"
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      },
      "post": {
        "summary": "首个请求创建私人会话并入队",
        "responses": {
          "202": {
            "description": "接受请求不等于任务成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            }
          },
          "400": {
            "description": "无效格式、模式或参数"
          },
          "401": {
            "description": "需要登录"
          },
          "403": {
            "description": "企业不可用、无成员权限或 CSRF 拒绝"
          },
          "404": {
            "description": "会话不存在、非本人或空间已撤权"
          },
          "409": {
            "description": "请求键冲突、任务版本变化或已有运行任务"
          },
          "503": {
            "description": "执行服务未启用"
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Send"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/conversations/{conversation}": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "conversation",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "读取最新或较早的有界任务记录及固定来源",
        "responses": {
          "200": {
            "description": "经当前权限校验，Cache-Control: private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            }
          },
          "400": {
            "description": "无效格式、模式或参数"
          },
          "401": {
            "description": "需要登录"
          },
          "403": {
            "description": "企业不可用、无成员权限或 CSRF 拒绝"
          },
          "404": {
            "description": "会话不存在、非本人或空间已撤权"
          },
          "409": {
            "description": "请求键冲突、任务版本变化或已有运行任务"
          },
          "503": {
            "description": "执行服务未启用"
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      }
    },
