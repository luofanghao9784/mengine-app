{
  "openapi": "3.1.0",
  "info": {
    "title": "Dreamcore Knowledge API",
    "version": "1.1.0",
    "description": "平台持有解析批次、版本和引用。本地关键词检索，仅检索最新文件版本的最新成功或部分成功批次；重新解析期间暂不返回旧批次。共享汇总排除所有个人空间。每次读取与执行分别验证空间权限。"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant}/workspaces/{workspace}/materials/{material}/versions/{version}/analysis": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "workspace",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "material",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "version",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "读取固定文件版本的最新解析状态和片段",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；内容使用 private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analysis"
                }
              }
            }
          },
          "400": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "维护者请求解析新批次",
        "description": "需要当前 CSRF；requestId 幂等；expectedGeneration 防止重复创建。相同 requestId 重试返回当前状态。",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId",
                  "expectedGeneration"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expectedGeneration": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "成功；内容使用 private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analysis"
                }
              }
            }
          },
          "400": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/knowledge/search": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "在服务端授权范围内匹配内容关键词",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "空白分隔最多 8 个关键词，同时匹配；不是语义检索。"
          },
          {
            "name": "workspace",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "省略仅搜索可见共享空间；传入个人空间必须是本人所有。"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；内容使用 private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Results"
                }
              }
            }
          },
          "400": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/knowledge/chunks/{chunk}": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "chunk",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "重新授权后读取不可变来源片段",
        "description": "固定解析批次与文件版本；重新解析不覆盖旧引用。",
        "responses": {
          "200": {
            "description": "成功；内容使用 private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chunk"
                }
              }
            }
          },
          "400": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "未授权、状态冲突或服务不可用；不返回资料路径或底层错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      }
    },
    "schemas": {
      "Chunk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenantId",
          "workspaceId",
          "materialId",
          "versionId",
          "runId",
          "version",
          "filename",
          "locator",
          "method",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "materialId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "filename": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "method": {
            "enum": [
              "TEXT",
              "TABLE",
              "OCR"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "Analysis": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "workspaceId",
          "materialId",
          "versionId",
          "generation",
          "status",
          "parserVersion",
          "warnings",
          "canMaintain",
          "available",
          "chunks",
          "hasMore"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "materialId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "QUEUED",
              "RUNNING",
              "READY",
              "PARTIAL",
              "FAILED",
              "UNSUPPORTED",
              "CANCELLED"
            ]
          },
          "parserVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canMaintain": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chunk"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Results": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "workspaceId",
          "query",
          "items",
          "hasMore",
          "matchStatus",
          "coverage"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "query": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chunk"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "matchStatus": {
            "enum": [
              "MATCHED",
              "NO_MATCH"
            ]
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "contractVersion": {
            "const": "1.0"
          },
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "PASSWORD_POLICY",
              "AUTHENTICATION_REQUIRED",
              "INVALID_CREDENTIALS",
              "ACCESS_DENIED",
              "STATE_CONFLICT",
              "INVITATION_DELIVERY_UNAVAILABLE",
              "INVITATION_NOT_FOUND",
              "INVITATION_INVALID",
              "INVITATION_UNAVAILABLE",
              "INVITATION_ACCOUNT_LOGIN_REQUIRED",
              "EXISTING_ACCOUNT_CREDENTIALS_NOT_ALLOWED",
              "INVITATION_ACCOUNT_MISMATCH",
              "IDEMPOTENCY_CONFLICT",
              "LOGIN_THROTTLED",
              "INTERNAL_ERROR",
              "TENANT_NOT_FOUND",
              "STALE_TENANT_VERSION",
              "TENANT_SUSPENDED",
              "INITIAL_ADMIN_UNAVAILABLE",
              "INITIAL_ADMIN_ALREADY_SET"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "contractVersion",
          "code",
          "message",
          "retryable"
        ],
        "additionalProperties": false
      },
      "VersionCoverage": {
        "type": "object",
        "properties": {
          "materialId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "runId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "QUEUED",
              "RUNNING",
              "READY",
              "PARTIAL",
              "FAILED",
              "UNSUPPORTED",
              "CANCELLED"
            ]
          },
          "warnings": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "materialId",
          "versionId",
          "version",
          "runId",
          "generation",
          "status",
          "warnings",
          "pinned"
        ],
        "additionalProperties": false
      },
      "Coverage": {
        "type": "object",
        "description": "Only currently authorized scope is counted. Unparsed files have unknown query relevance. Version details are bounded separately from result pagination.",
        "properties": {
          "scope": {
            "enum": [
              "AUTHORIZED_WORKSPACE",
              "AUTHORIZED_SHARED",
              "SELECTED_VERSIONS"
            ]
          },
          "status": {
            "enum": [
              "EMPTY",
              "READY",
              "PARTIAL",
              "NOT_READY"
            ]
          },
          "relevance": {
            "const": "NOT_ASSESSED"
          },
          "versions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/VersionCoverage"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "totalVersions": {
            "type": "integer",
            "minimum": 0
          },
          "searchableVersions": {
            "type": "integer",
            "minimum": 0
          },
          "partialVersions": {
            "type": "integer",
            "minimum": 0
          },
          "notReadyVersions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "scope",
          "status",
          "relevance",
          "versions",
          "hasMore",
          "totalVersions",
          "searchableVersions",
          "partialVersions",
          "notReadyVersions"
        ],
        "additionalProperties": false
      }
    }
  }
}
