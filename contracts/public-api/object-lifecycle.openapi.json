{
  "openapi": "3.1.0",
  "info": {
    "title": "Object lifecycle",
    "version": "1.0.0",
    "description": "Fixed event-anchored retention, current source authorization, bounded scope execution, and online erasure receipts. Old backups and independent publications are separate."
  },
  "security": [
    {
      "session": []
    }
  ],
