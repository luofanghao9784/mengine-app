              "format": "uuid"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "TASK",
                "DOCUMENT",
                "ARTIFACT",
                "EXPERIENCE_VERSION",
                "FEEDBACK_VERSION",
                "EVALUATION_VERSION",
                "EVALUATION_RUN",
                "EXPORT_CACHE"
              ]
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "DISABLED",
                "TRASHED",
                "ISOLATED",
                "PURGE_PENDING",
                "PURGE_FAILED",
                "PURGED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized metadata only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "description": "Current permission required"
          },
          "404": {
            "description": "Unavailable in current authorized scope"
          },
          "409": {
            "description": "Revision, lifecycle or active-method evidence conflict"
          }
        }
      }
    },
