  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "SESSION"
      },
      "platformSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION",
        "description": "统一身份会话；服务端另行核对总台角色，企业成员身份不授予平台权限。写入前从 /api/platform-admin/v1/auth/csrf 取得令牌。"
      }
    },
    "schemas": {
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "DISABLE",
              "ENABLE",
              "TRASH",
              "RESTORE",
              "PURGE",
              "RETRY",
              "CLASSIFY_TRIAL"
            ]
          },
          "irreversibleConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "requestId",
          "expectedRevision",
          "action",
          "irreversibleConfirmed"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "PURGE"
                }
              }
            },
            "then": {
              "properties": {
                "irreversibleConfirmed": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "TASK",
              "DOCUMENT",
              "ARTIFACT",
              "EXPERIENCE_VERSION",
              "FEEDBACK_VERSION",
              "EVALUATION_VERSION",
              "EVALUATION_RUN",
              "EXPORT_CACHE",
              "PROFILE_VERSION",
              "METHOD_VERSION"
            ]
          },
          "objectId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED",
              "TRASHED",
              "ISOLATED",
              "PURGE_PENDING",
              "PURGE_FAILED",
              "PURGED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "originalAnchor": {
            "type": "string",
            "format": "date-time"
          },
          "formal": {
            "type": "boolean"
          },
          "policyKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "policyRevision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "policyDue": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "purgeAfter": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "DISABLE",
                "ENABLE",
                "TRASH",
                "RESTORE",
                "PURGE",
                "RETRY",
                "CLASSIFY_TRIAL"
              ]
            }
          },
          "contentState": {
            "type": "string",
            "enum": [
              "ONLINE_BODY_ERASED",
              "CURRENT_ORIGINAL_ACCESS_REQUIRED",
              "NORMAL_ACCESS_BLOCKED"
            ]
          },
          "backupState": {
            "type": "string",
            "enum": [
              "NOT_COVERED_BY_ONLINE_CLEANUP"
            ]
          }
        },
        "required": [
          "kind",
          "objectId",
          "workspaceId",
          "state",
          "revision",
          "originalAnchor",
          "formal",
          "policyKey",
          "policyRevision",
          "policyDue",
          "purgeAfter",
          "attempts",
          "errorCode",
          "completedAt",
          "actions",
          "contentState",
          "backupState"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "hasMore"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acceptedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "current": {
            "$ref": "#/components/schemas/Item"
          },
          "receiptStatus": {
            "type": "string",
            "enum": [
              "EXACT"
            ]
          }
        },
        "required": [
          "acceptedRevision",
          "current",
          "receiptStatus"
        ]
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object": {
            "$ref": "#/components/schemas/Item"
          },
          "trashDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "trialDeadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "methodDependency": {
            "type": "boolean"
          },
          "irreversible": {
            "const": true
          },
          "independentCopies": {
            "type": "string",
            "enum": [
              "INDEPENDENT_ENTERPRISE_PUBLICATIONS_SURVIVE"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "object",
          "trashDeadline",
          "trialDeadline",
          "methodDependency",
          "irreversible",
          "independentCopies",
          "blockers"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string"
          },
          "actorId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "revision",
          "action",
          "actorId",
          "createdAt"
        ]
      },
      "Technical": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "TASK",
              "DOCUMENT",
              "ARTIFACT",
              "EXPERIENCE_VERSION",
              "FEEDBACK_VERSION",
              "EVALUATION_VERSION",
              "EVALUATION_RUN",
              "EXPORT_CACHE",
              "PROFILE_VERSION",
              "METHOD_VERSION"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED",
              "TRASHED",
              "ISOLATED",
              "PURGE_PENDING",
              "PURGE_FAILED",
              "PURGED"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "state",
          "count"
        ]
      }
    }
  }
}
