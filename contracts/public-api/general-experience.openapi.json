          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "platformCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_PLATFORM"
      },
      "customerCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      }
    },
    "schemas": {
      "Method": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "steps", "applicable", "excluded", "tags", "basis"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            }
          },
          "applicable": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "excluded": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "basis": {
            "enum": ["OBSERVED_EXECUTION", "FEEDBACK_CORRECTION"]
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "versionId", "number", "status", "updatedAt", "title", "summary", "tags"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": ["AVAILABLE", "STOPPED"]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      },
      "Detail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "versionId", "number", "status", "updatedAt", "method"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": ["AVAILABLE", "STOPPED"]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "$ref": "#/components/schemas/Method"
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "hasMore"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Summary"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Processing": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "counts", "available", "stopped", "withdrawn", "checkedAt"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "WAITING",
              "PROCESSING",
              "RETRYING",
              "ADMITTED",
              "DUPLICATE",
              "NOT_ADMITTED",
              "UNAVAILABLE",
              "FAILED",
              "UNKNOWN"
            ],
            "properties": {
              "WAITING": {
                "type": "integer",
                "minimum": 0
              },
              "PROCESSING": {
                "type": "integer",
                "minimum": 0
              },
              "RETRYING": {
                "type": "integer",
                "minimum": 0
              },
              "ADMITTED": {
                "type": "integer",
                "minimum": 0
              },
              "DUPLICATE": {
                "type": "integer",
                "minimum": 0
              },
              "NOT_ADMITTED": {
                "type": "integer",
                "minimum": 0
              },
              "UNAVAILABLE": {
                "type": "integer",
                "minimum": 0
              },
              "FAILED": {
                "type": "integer",
                "minimum": 0
              },
              "UNKNOWN": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "stopped": {
            "type": "integer",
            "minimum": 0
          },
          "withdrawn": {
            "type": "integer",
            "minimum": 0
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
