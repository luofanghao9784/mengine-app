              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string",
              "enum": [
                "AVAILABLE",
                "STOPPED"
              ],
              "default": "AVAILABLE"
            },
            "description": "STOPPED means disabled only in this enterprise; global withdrawn bodies are never exposed."
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        ],
        "responses": {
