            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized projection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Management scope required"
          },
          "404": {
            "description": "Version no longer available"
          }
        }
      }
    },
    "/api/platform-admin/v1/experience-library/processing": {
      "get": {
        "description": "Only cleaned current general content; no tenant sources. Fixed version required for details.",
        "security": [
          {
            "platformCookie": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Authorized projection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processing"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Management scope required"
          },
          "404": {
            "description": "Version no longer available"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/general-experiences": {
      "get": {
        "description": "Only cleaned current general content; no tenant sources. Fixed version required for details.",
        "security": [
          {
            "customerCookie": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "enum": ["AVAILABLE"]
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized projection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Management scope required"
          },
          "404": {
            "description": "Version no longer available"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/general-experiences/{entry}": {
      "get": {
        "description": "Only cleaned current general content; no tenant sources. Fixed version required for details.",
        "security": [
          {
            "customerCookie": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "entry",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized projection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Management scope required"
          },
          "404": {
