{
  "openapi": "3.1.0",
  "info": {
    "title": "General experience read projections",
    "version": "1.0"
  },
  "paths": {
    "/api/platform-admin/v1/experience-library": {
      "get": {
        "description": "Only cleaned current general content; no tenant sources. Fixed version required for details.",
        "security": [
          {
            "platformCookie": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "enum": ["AVAILABLE", "STOPPED"]
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized projection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Management scope required"
          },
          "404": {
            "description": "Version no longer available"
          }
        }
      }
    },
    "/api/platform-admin/v1/experience-library/{entry}": {
      "get": {
        "description": "Only cleaned current general content; no tenant sources. Fixed version required for details.",
        "security": [
