{
  "openapi": "3.1.0",
  "info": {
    "title": "Dreamcore Private Briefing API",
    "version": "1.1.0",
    "description": "从实际成功的私人 AGENT 会话派生卡片；同一会话在当前筛选范围只保留最后一次成功回复。date 按指定 IANA zone 的本地日筛选，不代表自动分析或共享发布；关注、隐藏和尺寸偏好跨日期共用。管理员无内容旁路。 generatedOnly=true 以独立画报 artifact 的真实生成回执为准；标题、摘要和图表读取固定版本内容。刷新仅查询，不触发模型。"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant}/briefing": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "本人画报；先按权限、日期、空间、视图过滤，再分页",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "LATEST",
                "FOCUSED",
                "HIDDEN"
              ],
              "default": "LATEST"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "zone",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "Asia/Shanghai"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 20
            }
          },
          {
            "name": "generatedOnly",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "仅纳入成功生成并保存独立画报内容的任务。先过滤再选同会话最新成果和分页；普通回复不覆盖已有画报。"
          },
          {
            "name": "businessType",
            "in": "query",
            "description": "先按明确业务类型过滤，再排序和分页；历史无类型不猜测",
            "schema": {
              "enum": [
                "INFO",
                "DATA",
                "INSIGHT",
                "SUGGESTION",
                "RESULT"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "经当前权限验证，Cache-Control: private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "日期、时区、分页、请求体无效"
          },
          "401": {
            "description": "需要登录"
          },
          "403": {
            "description": "企业或成员不可用，或 CSRF 拒绝"
          },
          "404": {
            "description": "非本人会话、无成功成果或空间不可访问"
          },
          "409": {
            "description": "幂等键冲突或偏好版本冲突"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/briefing/{conversation}": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "conversation",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "修改本人卡片偏好，幂等键和乐观版本防止重复或覆盖",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Update"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "经当前权限验证，Cache-Control: private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preference"
                }
              }
            }
          },
          "400": {
            "description": "日期、时区、分页、请求体无效"
          },
          "401": {
            "description": "需要登录"
          },
          "403": {
            "description": "企业或成员不可用，或 CSRF 拒绝"
          },
          "404": {
            "description": "非本人会话、无成功成果或空间不可访问"
          },
          "409": {
            "description": "幂等键冲突或偏好版本冲突"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/briefing/layout": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "本人关注布局版本，不含成果正文",
        "responses": {
          "200": {
            "description": "当前权限下的本人布局；回执区分原执行版本与当前布局版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Layout"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "仅移动两张当前可读且已关注的本人卡片；不改变其他视图及业务内容",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LayoutMove"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "当前权限下的本人布局；回执区分原执行版本与当前布局版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayoutReceipt"
                }
              }
            }
          },
          "403": {
            "description": "企业、成员或业务状态无权"
          },
          "404": {
            "description": "目标或参考卡片不再可读/可布局"
          },
          "409": {
            "description": "BRIEFING_LAYOUT_CHANGED 或幂等冲突"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/briefing/{conversation}/preference": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "conversation",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "读取本人会话当前关注、隐藏和尺寸设置；不返回会话内容，用于保留其他设置的局部交互",
        "responses": {
          "200": {
            "description": "经当前权限验证，Cache-Control: private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preference"
                }
              }
            }
          },
          "400": {
            "description": "日期、时区、分页、请求体无效"
          },
          "401": {
            "description": "需要登录"
          },
          "403": {
            "description": "企业或成员不可用，或 CSRF 拒绝"
          },
          "404": {
            "description": "非本人会话、无成功成果或空间不可访问"
          }
        }
      }
    }
  },
