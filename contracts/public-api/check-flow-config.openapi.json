  "components": {
    "schemas": {
      "AdmissionStatus": {
        "type": "string",
        "enum": [
          "candidate",
          "admitted",
          "deprecated"
        ],
        "description": "模块版本准入状态（≠ admissionTestVerdict）"
      },
      "ConfigStatus": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "retired"
        ]
      },
      "StepBinding": {
        "type": "object",
        "required": [
          "stepId"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "enum": [
              "ingest",
              "parse",
              "quality-check",
              "review",
              "publish"
            ],
            "description": "首版步骤；quality-check 定稿名"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "toolPolicy": {
            "type": "string"
          },
          "budget": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "CheckFlowConfigVersion": {
        "type": "object",
        "required": [
          "configVersionId",
          "tenantId",
          "status",
          "stepBindings"
        ],
        "properties": {
          "configVersionId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "spaceId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConfigStatus"
          },
          "supersedes": {
            "type": "string",
            "description": "定稿血缘字段；≠ basedOn"
          },
          "stepBindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepBinding"
            }
          },
          "requiredChecks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CheckFlowConfigVersionCreate": {
        "type": "object",
        "required": [
          "stepBindings"
        ],
        "properties": {
          "spaceId": {
            "type": "string"
          },
          "supersedes": {
            "type": "string"
          },
          "stepBindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepBinding"
            }
          },
          "requiredChecks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "BindableModuleSummary": {
        "type": "object",
        "required": [
          "moduleVersionId",
          "admissionStatus"
        ],
        "properties": {
          "moduleVersionId": {
            "type": "string"
          },
          "capabilityId": {
            "type": "string"
          },
          "admissionStatus": {
            "$ref": "#/components/schemas/AdmissionStatus"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
