{
  "openapi": "3.1.0",
  "info": {
    "title": "工作推荐与站内呈现",
    "version": "1.2.0",
    "description": " generatedOnly=true 只读取已有独立画报内容；普通回复不覆盖旧画报。"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant}/recommendations": {
      "get": {
        "summary": "先对最新1000项当前获权成果排序再分页，显式报告窗口；打开动作不表示业务完成",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "workspaceId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          {
            "name": "snapshot",
            "in": "query",
            "description": "offset 大于0时必须与当前排序快照一致，否则409",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "generatedOnly",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "businessType",
            "in": "query",
            "description": "先按明确业务类型过滤，再排序和分页；历史无类型不猜测",
            "schema": {
              "enum": [
                "INFO",
                "DATA",
                "INSIGHT",
                "SUGGESTION",
                "RESULT"
              ]
            }
          },
          {
            "name": "publicationsOnly",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "focused",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前获权结果；private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "当前授权不足"
          },
          "409": {
            "description": "版本或排序快照已变更"
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/recommendations/settings": {
      "get": {
        "summary": "本人一般推荐设置",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前获权结果；private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "当前授权不足"
          },
          "409": {
            "description": "版本或排序快照已变更"
          }
        }
      },
      "post": {
        "summary": "以请求ID和预期修订修改；原请求重试返回原回执",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前获权结果；private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "当前授权不足"
          },
          "409": {
            "description": "版本或排序快照已变更"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Configure"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/recommendations/opened": {
      "post": {
        "summary": "用户显式打开指定版本入口的幂等记录；重新核验当前权限；不代表已阅读、采纳或业务完成",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前获权结果；private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Opened"
                }
              }
            }
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "当前授权不足"
          },
          "409": {
            "description": "版本或排序快照已变更"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Target"
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/recommendations/publications/{material}/preference": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "material",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "读取本人对共享企业副本的关注",
        "responses": {
          "200": {
            "description": "本人当前关注状态；重新核对共享副本权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationPreference"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "关注或取消关注；不创建持续计划、不改变企业副本",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicationFollow"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "本人当前关注状态；重新核对共享副本权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationPreference"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/recommendations/cards": {
      "parameters": [],
      "get": {
        "summary": "按本批新生成的卡片ID读取当前获准内容，供追加到阅读流",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 20
            },
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "仅本人当前可读卡片，private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      }
    },
    "schemas": {
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "enabled"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "Target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "versionKey"
        ],
        "properties": {
          "kind": {
            "enum": [
              "TASK",
              "PUBLICATION"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "versionKey": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "Content": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "versionKey",
          "workspaceId",
          "workspaceName",
          "title",
          "excerpt",
          "truncated",
          "createdAt",
          "executionClass",
          "conversationId",
          "taskRevision",
          "attempt",
          "preferenceRevision",
          "materialId",
          "materialVersion",
          "filename",
          "pinned",
          "openedAt"
        ],
        "properties": {
          "kind": {
            "enum": [
              "TASK",
              "PUBLICATION"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "versionKey": {
            "type": "string",
            "maxLength": 120
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceName": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "excerpt": {
            "type": "string",
            "maxLength": 1200
          },
          "truncated": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "executionClass": {
            "enum": [
              "verification",
              "live",
              "PUBLISHED_COPY"
            ]
          },
          "conversationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "taskRevision": {
            "type": "integer",
            "minimum": 0
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "preferenceRevision": {
            "type": "integer",
            "minimum": 0
          },
          "materialId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "materialVersion": {
            "type": "integer",
            "minimum": 0
          },
          "filename": {
            "type": "string",
            "maxLength": 255
          },
          "pinned": {
            "type": "boolean"
          },
          "openedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Method": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "versionId",
          "adoptionRevision",
          "scope",
          "workspaceId",
          "configurationSha"
        ],
        "properties": {
          "versionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "adoptionRevision": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "enum": [
              "BUILTIN",
              "TENANT",
              "WORKSPACE"
            ]
          },
          "workspaceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "configurationSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Presentation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "renderer",
          "style",
          "profileId",
          "profileRevision"
        ],
        "properties": {
          "renderer": {
            "const": "source-preserving-v1"
          },
          "style": {
            "enum": [
              "DEFAULT",
              "CONCISE",
              "TABLE_FIRST",
              "CONCLUSION_FIRST",
              "DETAIL_FIRST"
            ]
          },
          "profileId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "profileRevision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Configure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "enabled"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "Opened": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "openedAt",
          "evidence",
          "businessOutcome"
        ],
        "properties": {
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "const": "USER_OPEN_ACTION"
          },
          "businessOutcome": {
            "const": "NOT_ASSESSED"
          }
        }
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "score",
          "method",
          "presentation",
          "reason",
          "availability",
          "feedbackTarget"
        ],
        "properties": {
          "content": {
            "$ref": "#/components/schemas/Content"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "method": {
            "$ref": "#/components/schemas/Method"
          },
          "presentation": {
            "$ref": "#/components/schemas/Presentation"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "availability": {
            "const": "AVAILABLE_IN_APP"
          },
          "feedbackTarget": {
            "$ref": "#/components/schemas/FeedbackTarget"
          },
          "briefing": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifactId",
                  "sha256",
                  "content"
                ],
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "content": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "schemaVersion",
                          "businessType",
                          "title",
                          "summary",
                          "analysis",
                          "chart",
                          "source",
                          "calculationArtifactId",
                          "calculationSha256",
                          "generatedAt"
                        ],
                        "properties": {
                          "schemaVersion": {
                            "const": "briefing-data-v1"
                          },
                          "businessType": {
                            "const": "DATA"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 4,
                            "maxLength": 80
                          },
                          "summary": {
                            "type": "string",
                            "minLength": 12,
                            "maxLength": 240
                          },
                          "analysis": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 4,
                            "items": {
                              "type": "string",
                              "minLength": 12,
                              "maxLength": 500
                            }
                          },
                          "chart": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "type",
                              "metric",
                              "unit",
                              "baseline",
                              "current",
                              "range",
                              "rows",
                              "totals"
                            ],
                            "properties": {
                              "type": {
                                "const": "GROUPED_BAR"
                              },
                              "metric": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100
                              },
                              "unit": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100
                              },
                              "baseline": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100
                              },
                              "current": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100
                              },
                              "range": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 32
                              },
                              "rows": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 50,
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "group",
                                    "baseline",
                                    "current",
                                    "difference",
                                    "changePercent",
                                    "baselineRank",
                                    "currentRank",
                                    "issue"
                                  ],
                                  "properties": {
                                    "group": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "minLength": 1,
                                          "maxLength": 100
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "baseline": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "current": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "difference": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "changePercent": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "baselineRank": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 1,
                                          "maximum": 50
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "currentRank": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 1,
                                          "maximum": 50
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "issue": {
                                      "anyOf": [
                                        {
                                          "enum": [
                                            "MISSING_PERIOD",
                                            "NON_POSITIVE_BASELINE",
                                            "UNEQUAL_GROUP_COVERAGE"
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  }
                                }
                              },
                              "totals": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "group",
                                  "baseline",
                                  "current",
                                  "difference",
                                  "changePercent",
                                  "baselineRank",
                                  "currentRank",
                                  "issue"
                                ],
                                "properties": {
                                  "group": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 100
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "baseline": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "current": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "difference": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "changePercent": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "pattern": "^-?\\d{1,64}(?:\\.\\d{1,12})?$"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "baselineRank": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 50
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "currentRank": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 50
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "issue": {
                                    "anyOf": [
                                      {
                                        "enum": [
                                          "MISSING_PERIOD",
                                          "NON_POSITIVE_BASELINE",
                                          "UNEQUAL_GROUP_COVERAGE"
                                        ]
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
