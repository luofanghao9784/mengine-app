    "/api/platform-admin/v1/tenants/{tenant}/governance-recovery-requests": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "总台记录待核验失联恢复；不核实证据、不指定接班、不恢复登录、不读取正文",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "待核验回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recovery"
                }
              }
            }
          },
          "403": {
            "description": "没有有效平台身份"
          }
        },
        "security": [
          {
            "platformSessionCookie": []
          }
        ]
      }
    },
    "/api/platform-admin/v1/tenants/{tenant}/governance-recovery-requests/{id}": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "总台查看无正文的核验请求元信息",
        "responses": {
          "200": {
            "description": "请求状态，不代表恢复完成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recovery"
                }
              }
            }
          },
          "403": {
            "description": "没有有效平台身份"
          }
        },
        "security": [
          {
            "platformSessionCookie": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      },
      "platformSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_PLATFORM",
        "description": "独立总台会话；企业用户 Cookie 不授予平台权限。写入前从 /api/platform-admin/v1/auth/csrf 取得令牌。"
      }
    },
    "schemas": {
      "Change": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "requestId",
          "expectedVersion"
        ]
      },
      "Capability": {
        "type": "string",
        "enum": [
          "OWNER",
          "TENANT_CONFIG",
          "PROFILE_MAINTAIN",
          "CONTENT_MAINTAIN",
          "EXPERIENCE_MAINTAIN",
          "EVALUATION_MAINTAIN",
          "LIFECYCLE_PURGE",
          "BULK_EXPORT",
          "METHOD_ADOPT",
          "PLAN_CONFIGURE",
          "MEMBER_OFFBOARD",
          "TENANT_EXIT"
        ]
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "revision": {
            "type": "integer"
          },
          "owner": {
            "type": "boolean"
          },
          "canConfigure": {
            "type": "boolean"
          },
          "canAcceptInitialResponsibility": {
            "type": "boolean"
          },
          "canEnterManagement": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "workspaceId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "capability": {
                  "$ref": "#/components/schemas/Capability"
                }
              },
              "required": [
                "workspaceId",
                "capability"
              ]
            }
          },
          "pendingHandover": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "fromAccount": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "toAccount": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PENDING"
                    ]
                  }
                },
                "required": [
                  "id",
                  "fromAccount",
                  "toAccount",
                  "status"
                ]
              }
            ]
          }
        },
        "required": [
          "tenantId",
          "ownerId",
          "revision",
          "owner",
          "canConfigure",
          "canAcceptInitialResponsibility",
          "canEnterManagement",
          "capabilities",
          "pendingHandover"
        ]
      },
      "RoleChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "enum": [
              "TENANT_ADMIN",
              "MEMBER"
            ]
          }
        },
        "required": [
          "requestId",
          "expectedVersion",
          "role"
        ]
      },
      "Role": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "TENANT_ADMIN",
              "MEMBER"
            ]
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "accountId",
          "role",
          "version"
        ]
      },
      "CapabilityChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "capability": {
            "type": "string",
            "enum": [
              "PROFILE_MAINTAIN",
              "EXPERIENCE_MAINTAIN",
              "EVALUATION_MAINTAIN",
              "LIFECYCLE_PURGE",
              "BULK_EXPORT",
              "METHOD_ADOPT",
              "PLAN_CONFIGURE",
              "MEMBER_OFFBOARD",
              "TENANT_EXIT"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "requestId",
          "expectedVersion",
          "accountId",
          "capability",
          "enabled"
        ]
      },
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
