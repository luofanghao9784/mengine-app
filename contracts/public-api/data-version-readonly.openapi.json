{
  "openapi": "3.1.0",
  "info": {
    "title": "数据版本只读（data-version-readonly · B6/B7）",
    "version": "0.0.0-skeleton",
    "description": "【骨架 · 后端未实现 · 勿当 Live】CT-031 OpenAPI 提纲占位（表面 workspace）。字段/枚举对齐 docs/architecture/契约分片-检查与能力.md 与 ADR-B8 D8-5；响应以 501 占位；禁止当作已实现 API 或假 Live 业务数据。"
  },
  "paths": {
    "/api/workspace/v1/data-versions": {
      "get": {
        "operationId": "listDataVersions",
        "summary": "列出本空间数据版本摘要（只读骨架）",
        "tags": [
          "data-version"
        ],
        "responses": {
          "200": {
            "description": "骨架占位 · 未实现；员工只读",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DataVersionSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/v1/data-versions/{inputVersionId}": {
      "get": {
        "operationId": "getDataVersion",
        "summary": "获取数据版本摘要（只读骨架）",
        "tags": [
          "data-version"
        ],
        "parameters": [
          {
            "name": "inputVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "骨架占位 · 未实现",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataVersionSummary"
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/v1/data-versions/{inputVersionId}/issues": {
      "get": {
        "operationId": "listDataVersionIssuesReadonly",
        "summary": "B7 问题只读视图（骨架；不可 publish/debug）",
        "tags": [
          "data-version"
        ],
        "parameters": [
          {
            "name": "inputVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "骨架占位 · 未实现",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueReadonlyView"
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "awaiting_human",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "QualityVerdict": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "pending"
        ],
        "description": "定稿含 pending；≠ admissionTestVerdict"
      },
      "PublishStatus": {
        "type": "string",
        "enum": [
          "unpublished",
          "published",
          "superseded"
        ]
      },
      "ExecutionMode": {
        "type": "string",
        "enum": [
          "simulated",
          "real"
        ]
      },
      "IssueKind": {
        "type": "string",
        "enum": [
          "unit_mix",
          "date_ambiguous",
          "missing_business_key",
          "conflict_duplicate",
          "other"
        ]
      },
      "QualityIssueEvidence": {
        "type": "object",
        "required": [
          "inputVersionId"
        ],
        "properties": {
          "inputVersionId": {
            "type": "string"
          },
          "row": {
            "type": "integer"
          },
          "column": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "QualityIssue": {
        "type": "object",
        "required": [
          "issueId",
          "kind",
          "qualityVerdict",
          "summary"
        ],
        "properties": {
          "issueId": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/IssueKind"
          },
          "qualityVerdict": {
            "$ref": "#/components/schemas/QualityVerdict"
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/QualityIssueEvidence"
          },
          "rawValue": {
            "type": "string"
          },
          "proposedValue": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DataVersionSummary": {
        "type": "object",
        "required": [
          "assetName",
          "inputVersionId",
          "qualityVerdict",
          "publishStatus",
          "isStale"
        ],
        "properties": {
          "assetName": {
            "type": "string"
          },
          "inputVersionId": {
            "type": "string",
            "description": "统一命名；≠ inputDataVersionId"
          },
          "sourceLabel": {
            "type": "string"
          },
          "stageLabel": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "runStatus": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "qualityVerdict": {
            "$ref": "#/components/schemas/QualityVerdict"
          },
          "publishStatus": {
            "$ref": "#/components/schemas/PublishStatus"
          },
          "openIssueCount": {
            "type": "integer",
            "minimum": 0
          },
          "publishedVersionId": {
            "type": "string"
          },
          "isStale": {
            "type": "boolean",
            "description": "定稿独立字段；不进三态枚举"
          },
          "executionMode": {
            "$ref": "#/components/schemas/ExecutionMode"
          }
        },
        "additionalProperties": false
      },
      "IssueReadonlyView": {
        "type": "object",
        "required": [
          "inputVersionId",
          "issues"
        ],
        "properties": {
          "inputVersionId": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QualityIssue"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
