{
  "openapi": "3.1.0",
  "info": {
    "title": "Material lifecycle API",
    "version": "1.0"
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant}/workspaces/{space}/lifecycle": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "space",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Current authorized scope; no cached public response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/workspaces/{space}/lifecycle/{kind}/{id}": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "space",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "kind",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "MATERIAL",
              "FOLDER"
            ]
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Current authorized scope; no cached public response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          }
        }
      },
      "post": {
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authorized scope; no cached public response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenant}/workspaces/{space}/lifecycle/cleanup/{id}": {
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "space",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Current authorized scope; no cached public response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cleanup"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "state",
          "revision",
          "trashedAt",
          "purgeAfter",
          "cleanupJobId",
          "canPurge"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "MATERIAL",
              "FOLDER"
            ]
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "TRASHED",
              "PURGING",
              "PURGED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "trashedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "purgeAfter": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "cleanupJobId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "canPurge": {
            "type": "boolean"
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "action"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "TRASH",
              "RESTORE",
              "PURGE",
              "RETRY_CLEANUP"
            ]
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId",
          "kind",
          "action",
          "resultingState",
          "revision",
          "occurredAt",
          "purgeAfter",
          "cleanupJobId"
        ],
        "properties": {
          "objectId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "MATERIAL",
              "FOLDER"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "TRASH",
              "RESTORE",
              "PURGE",
              "RETRY_CLEANUP"
            ]
          },
          "resultingState": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "TRASHED",
              "PURGING",
              "PURGED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "purgeAfter": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "cleanupJobId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Cleanup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "revision",
          "attempts",
          "errorCode",
          "originals",
          "originalsRemoved",
          "completedAt",
          "backupState"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "QUEUED",
              "CLEANING",
              "FAILED",
              "COMPLETE"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "originals": {
            "type": "integer",
            "minimum": 0
          },
          "originalsRemoved": {
            "type": "integer",
            "minimum": 0
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "backupState": {
            "const": "NOT_COVERED_BY_ONLINE_CLEANUP"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "documents",
          "versions",
          "folders",
          "restoration"
        ],
        "properties": {
          "item": {
            "$ref": "#/components/schemas/Item"
          },
          "documents": {
            "type": "integer",
            "minimum": 0
          },
          "versions": {
            "type": "integer",
            "minimum": 0
          },
          "folders": {
            "type": "integer",
            "minimum": 0
          },
          "restoration": {
            "const": "CURRENT_PERMISSIONS_NO_TASK_RESTART"
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
