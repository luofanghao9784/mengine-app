{
  "openapi": "3.1.0",
  "info": {
    "title": "能力登记与准入（capability-registry）",
    "version": "0.0.0-skeleton",
    "description": "CT-034-A：平台目录已落库。POST /api/agent-admin/v1/capabilities 已实现：须第四端会话与 CSRF，合法请求落库返回 201；未登录 401，CSRF 无效 403，非法字段 400，重复登记 409。错误体沿用 error.schema.json 四字段形状，登记域扩展 code。CT-040 开通写已落库；GET listCapabilities 已实现（CT-044，只读 qo_capability，空目录为 []）；模块、准入与 grants GET 仍是骨架 · 未实现；本 POST /api/agent-admin/v1/tenants/{tenantId}/grants 不是模块版本授权。"
  },
  "paths": {
    "/api/agent-admin/v1/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "summary": "列出已登记平台目录（CT-044）",
        "tags": [
          "capability-admission"
        ],
        "responses": {
          "200": {
            "description": "CT-044：已登记平台目录。空目录为 []。不返回开通信息。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Capability"
                  }
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "registerCapability",
        "summary": "登记能力（CT-034-A 平台目录已落库）",
        "tags": [
          "capability-admission"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Capability"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CT-034-A：平台目录已落库",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capability"
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      }
    },
