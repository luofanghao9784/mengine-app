  "components": {
    "schemas": {
      "EnterpriseFunction": {
        "type": "string",
        "enum": [
          "document-parse",
          "table-compare",
          "quality-check",
          "semantic-annotation",
          "repair-suggestion"
        ],
        "description": "ADR-B8 闭集；首版演示登记闭环仅 quality-check；预留值登记返回 ENTERPRISE_FUNCTION_NOT_ENABLED"
      },
      "RuntimeKind": {
        "type": "string",
        "enum": [
          "in-process",
          "local-process",
          "model-agent"
        ],
        "description": "对外闭集三值；engine-http 不暴露"
      },
      "AdmissionStatus": {
        "type": "string",
        "enum": [
          "candidate",
          "admitted",
          "deprecated"
        ],
        "description": "模块版本准入状态（≠ admissionTestVerdict）"
      },
      "AdmissionTestVerdict": {
        "type": "string",
        "enum": [
          "passed",
          "failed",
          "pending"
        ],
        "description": "准入测试结论；独立字段，勿复用 qualityVerdict"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "awaiting_human",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "Capability": {
        "type": "object",
        "required": [
          "capabilityId",
          "name"
        ],
        "properties": {
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          },
          "capabilityId": {
            "type": "string",
            "description": "如 quality-check；≠ enterpriseFunction"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "quality_check"
            ]
          }
        },
        "additionalProperties": false
      },
      "CapabilityModuleVersion": {
        "type": "object",
        "required": [
          "capabilityId",
          "moduleVersionId",
          "enterpriseFunction",
          "runtimeKind",
          "admissionStatus"
        ],
        "properties": {
          "capabilityId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "moduleVersion": {
            "type": "string"
          },
          "interfaceVersion": {
            "type": "string"
          },
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          },
          "modelVendor": {
            "type": "string",
            "description": "runtimeKind=model-agent 时必填；无密钥"
          },
          "runtimeKind": {
            "$ref": "#/components/schemas/RuntimeKind"
          },
          "supportedFormats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ioSchemaRef": {
            "type": "string"
          },
          "permissionsRequired": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "costClass": {
            "type": "string"
          },
          "admissionStatus": {
            "$ref": "#/components/schemas/AdmissionStatus"
          },
          "lastTestRecordId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "AdmissionTestRecord": {
        "type": "object",
        "required": [
          "testRecordId",
          "moduleVersionId",
          "runStatus",
          "admissionTestVerdict"
        ],
        "properties": {
          "testRecordId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "runStatus": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "admissionTestVerdict": {
            "$ref": "#/components/schemas/AdmissionTestVerdict"
          },
          "sampleSetId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CapabilityTenantGrant": {
        "type": "object",
        "required": [
          "moduleVersionId",
          "tenantId",
          "isDefault",
          "grantedAt"
        ],
        "properties": {
          "moduleVersionId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "description": "被授权对象；非执行作用域"
          },
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          },
          "isDefault": {
            "type": "boolean"
          },
          "grantedBy": {
            "type": "string"
          },
          "grantedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CapabilityTenantGrantCreate": {
        "type": "object",
        "required": [
          "moduleVersionId",
          "isDefault"
        ],
        "properties": {
          "moduleVersionId": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
