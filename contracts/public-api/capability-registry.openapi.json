            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "admissionStatus"
                ],
                "properties": {
                  "admissionStatus": {
                    "$ref": "#/components/schemas/AdmissionStatus"
                  }
                },
