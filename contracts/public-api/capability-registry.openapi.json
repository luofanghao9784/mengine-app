            "description": "骨架占位 · 未实现；勿当 Live",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Capability"
                  }
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
