    "/api/agent-admin/v1/tenants/{tenantId}/grants": {
      "get": {
        "operationId": "listCapabilityTenantGrants",
        "summary": "列出租户能力授权（骨架）",
        "tags": [
          "capability-admission"
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "被授权租户（路径参数；非执行作用域）"
          }
        ],
        "responses": {
          "200": {
            "description": "骨架占位 · 未实现",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CapabilityTenantGrant"
                  }
                }
              }
            }
          },
          "401": {
            "description": "会话无效（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "资格或 CSRF 不符合（骨架占位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "501": {
            "description": "骨架未实现（Not Implemented）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCapabilityTenantGrant",
        "summary": "把已登记的企业功能开通给企业（已落库）",
        "tags": [
          "capability-admission"
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapabilityTenantGrantCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "首次开通，已落库并回读",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityTenantGrantOpened"
                }
              }
            }
          },
          "200": {
            "description": "重复开通，返回原行，不覆盖指向或 granted_at",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityTenantGrantOpened"
                }
              }
            }
          },
          "400": {
            "description": "请按要求填写开通内容；未知字段：有无法识别的字段，请检查后再提交",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "还没有登录，请先登录后再试",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "登录校验未通过，请刷新页面后再试",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "企业不存在或尚未登记",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "已经开通过了，不能改成另一项",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnterpriseFunction": {
        "type": "string",
        "enum": [
          "document-parse",
          "table-compare",
          "quality-check",
          "semantic-annotation",
          "repair-suggestion"
        ],
        "description": "ADR-B8 闭集；首版演示登记闭环仅 quality-check；预留值登记返回 ENTERPRISE_FUNCTION_NOT_ENABLED"
      },
      "RuntimeKind": {
        "type": "string",
        "enum": [
          "in-process",
          "local-process",
          "model-agent"
        ],
        "description": "对外闭集三值；engine-http 不暴露"
      },
      "AdmissionStatus": {
        "type": "string",
        "enum": [
          "candidate",
          "admitted",
          "deprecated"
        ],
        "description": "模块版本准入状态（≠ admissionTestVerdict）"
      },
      "AdmissionTestVerdict": {
        "type": "string",
        "enum": [
          "passed",
          "failed",
          "pending"
        ],
        "description": "准入测试结论；独立字段，勿复用 qualityVerdict"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "awaiting_human",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "Capability": {
        "type": "object",
        "required": [
          "capabilityId",
          "name"
        ],
        "properties": {
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          },
          "capabilityId": {
            "type": "string",
            "description": "如 quality-check；≠ enterpriseFunction"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "quality_check"
            ]
          }
        },
        "additionalProperties": false
      },
      "CapabilityModuleVersion": {
        "type": "object",
        "required": [
          "capabilityId",
          "moduleVersionId",
          "enterpriseFunction",
          "runtimeKind",
          "admissionStatus"
        ],
        "properties": {
          "capabilityId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "moduleVersion": {
            "type": "string"
          },
          "interfaceVersion": {
            "type": "string"
          },
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          },
          "modelVendor": {
            "type": "string",
            "description": "runtimeKind=model-agent 时必填；无密钥"
          },
          "runtimeKind": {
            "$ref": "#/components/schemas/RuntimeKind"
          },
          "supportedFormats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ioSchemaRef": {
            "type": "string"
          },
          "permissionsRequired": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "costClass": {
            "type": "string"
          },
          "admissionStatus": {
            "$ref": "#/components/schemas/AdmissionStatus"
          },
          "lastTestRecordId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "AdmissionTestRecord": {
        "type": "object",
        "required": [
          "testRecordId",
          "moduleVersionId",
          "runStatus",
          "admissionTestVerdict"
        ],
        "properties": {
          "testRecordId": {
            "type": "string"
          },
          "moduleVersionId": {
            "type": "string"
          },
          "runStatus": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "admissionTestVerdict": {
            "$ref": "#/components/schemas/AdmissionTestVerdict"
          },
          "sampleSetId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CapabilityTenantGrant": {
        "type": "object",
        "required": [
          "moduleVersionId",
          "tenantId",
          "isDefault",
          "grantedAt"
        ],
        "properties": {
          "moduleVersionId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "description": "被授权对象；非执行作用域"
          },
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          },
          "isDefault": {
            "type": "boolean"
          },
          "grantedBy": {
            "type": "string"
          },
          "grantedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CapabilityTenantGrantCreate": {
        "type": "object",
        "required": [
          "capabilityId",
          "enterpriseFunction"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          }
        },
        "additionalProperties": false
      },
      "CapabilityTenantGrantOpened": {
        "type": "object",
        "required": [
          "tenantId",
          "capabilityId",
          "enterpriseFunction",
          "grantedAt"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "capabilityId": {
            "type": "string"
          },
          "enterpriseFunction": {
            "$ref": "#/components/schemas/EnterpriseFunction"
          },
          "grantedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
