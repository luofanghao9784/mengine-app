{
  "openapi": "3.1.0",
  "info": {
    "title": "Engine operational telemetry",
    "version": "1.1.0",
    "description": "Read-only database-state snapshot; no physical utilization or autonomous evolution is inferred. Active records have no creation-time cutoff. Completed means processing completion, not quality, delivery or business success. No business identifiers or text. Historic failures retained. Streaming task counted only in output."
  },
  "paths": {
    "/api/platform-admin/v1/engine-telemetry": {
      "get": {
        "security": [
          {
            "platformSessionCookie": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Snapshot. No private content or model diagnostics.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Current management authority required"
          }
        }
      }
    },
    "/api/platform-admin/v1/engine-telemetry/tenants": {
      "get": {
        "security": [
          {
            "platformSessionCookie": []
          }
        ],
        "parameters": [],
        "description": "Platform only. Running records per tenant using the snapshot classification. General adjustment has no tenant and is not attributed. Counts only: no channel, task, person, file or business content.",
        "responses": {
          "200": {
            "description": "Tenants with running records, most first, at most 10; the rest are folded into otherTenants/otherRunning.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantDistribution"
                }
              }
            }
          },
          "401": {
            "description": "Platform authentication required"
          },
          "403": {
            "description": "Current platform authority required"
          }
        }
      }
    },
    "/api/tenant-admin/v1/tenants/{tenant}/engine-telemetry": {
      "get": {
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot. No private content or model diagnostics.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Current management authority required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      },
      "platformSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_PLATFORM",
        "description": "独立总台会话；企业用户 Cookie 不授予平台权限。写入前从 /api/platform-admin/v1/auth/csrf 取得令牌。"
      }
    },
    "schemas": {
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "checkedAt",
          "recentSeconds",
          "evolution",
          "channels"
        ],
        "properties": {
          "tenantId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recentSeconds": {
            "const": 300
          },
          "evolution": {
            "const": "NOT_CONNECTED"
          },
          "channels": {
            "type": "array",
            "minItems": 9,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/Channel"
            }
          }
        }
      },
      "Channel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "running",
          "queued",
          "waiting",
          "failed",
          "unknown",
          "completedRecent",
          "lastCompletedAt"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "COLLECTION",
              "KNOWLEDGE",
              "RETRIEVAL",
              "TASK",
              "COMPANY",
              "EXPERIENCE",
              "GENERALIZATION",
              "GENERAL_ADJUSTMENT",
              "RESPONSE",
              "EXPORT"
            ]
          },
          "running": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "queued": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "waiting": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unknown": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completedRecent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastCompletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "TenantDistribution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkedAt",
          "tenants",
          "otherTenants",
          "otherRunning"
        ],
        "properties": {
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tenants": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/TenantRunning"
            }
          },
          "otherTenants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "otherRunning": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "TenantRunning": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "tenantName",
          "running"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "running": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
