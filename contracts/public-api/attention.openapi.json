{
  "openapi": "3.1.0",
  "info": {
    "title": "获权待办投影",
    "version": "1.0.0"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/tenants/{tenant}/attention": {
      "get": {
        "summary": "按原对象当前状态投影本人或获权共享维护待办",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "managed",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前获权范围；private, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "DREAMCORE_SESSION"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "TASK",
              "SOURCE",
              "PLAN"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceName": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "state": {
            "enum": [
              "WAITING_INPUT",
              "PARTIAL",
              "RESULT_UNKNOWN",
              "OVERDUE",
              "MISSING_DATA",
              "AUTHORIZATION_REQUIRED",
              "PLAN_NEEDS_ATTENTION"
            ]
          },
          "instruction": {
            "type": "string",
            "maxLength": 200
          },
          "actionLabel": {
            "type": "string",
            "maxLength": 50
          },
          "conversationId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "dueAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "changedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "id",
          "workspaceId",
          "workspaceName",
          "title",
          "state",
          "instruction",
          "actionLabel",
          "conversationId",
          "revision",
          "dueAt",
          "changedAt"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "enum": [
              "MINE",
              "MANAGED"
            ]
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "tenantId",
          "scope",
          "total",
          "items",
          "hasMore",
          "checkedAt"
        ]
      }
    }
  }
}
