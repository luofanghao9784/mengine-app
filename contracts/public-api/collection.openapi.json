{
  "openapi": "3.1.0",
  "info": {
    "title": "Scoped data collection",
    "version": "1.0.0",
    "description": "Deployment routes and external credentials cannot be configured through the customer API. Automation and immediate update are independent of briefing generation; administration never grants content visibility."
  },
  "paths": {
    "/api/v1/tenants/{tenant}/database/summary": {
      "get": {
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Customer session required"
          },
          "403": {
            "description": "Current authority or CSRF rejected"
          },
          "404": {
            "description": "Not found or outside authorized scope"
          },
          "409": {
            "description": "State changed, deployment unavailable or request conflict"
          }
        }
      }
    },
