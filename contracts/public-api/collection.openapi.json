  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "SESSION"
      }
    },
    "schemas": {
      "Schedule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "frequency",
          "dailyTime",
          "timeZone"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "frequency": {
            "enum": [
              null,
              "QUARTER_HOUR",
              "HOURLY",
              "DAILY"
            ]
          },
          "dailyTime": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "frequency": {
                  "enum": [
                    "QUARTER_HOUR",
                    "HOURLY",
                    "DAILY"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "frequency": {
                  "const": "DAILY"
                }
              }
            },
            "then": {
              "properties": {
                "dailyTime": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "dailyTime": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "triggerKind",
          "status",
          "reason",
          "createdAt",
          "startedAt",
          "finishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "triggerKind": {
            "enum": [
              "MANUAL",
              "SCHEDULED"
            ]
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "INTERRUPTED"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Connection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "routeLabel",
          "accessSummary",
          "status",
          "revision",
          "canControl",
          "schedule",
          "nextDue",
          "lastSuccessAt",
          "currentRun",
          "lastRun"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "routeLabel": {
            "type": "string"
          },
          "accessSummary": {
            "type": "string"
          },
          "status": {
            "enum": [
              "READY",
              "UNAVAILABLE",
              "UNCONFIGURED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "canControl": {
            "type": "boolean"
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "nextDue": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastSuccessAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "currentRun": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Run"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastRun": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Run"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Dataset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "connectionId",
          "workspaceId",
          "workspaceName",
          "name",
          "description",
          "columns",
          "version",
          "rowCount",
          "collectedAt",
          "coverageThrough",
          "latestRun"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connectionId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "rowCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "collectedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "coverageThrough": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "latestRun": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Run"
              },
              {
                "type": "null"
              }
            ]
          },
          "fieldDefinitions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/DatasetField"
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasets",
          "available",
          "updating",
          "failed"
        ],
        "properties": {
          "datasets": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "updating": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DatasetPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dataset"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset",
          "rows",
          "hasMore"
        ],
        "properties": {
          "dataset": {
            "$ref": "#/components/schemas/Dataset"
          },
          "rows": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Configure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "schedule"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          }
        }
      },
      "Update": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DatasetField": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "column",
          "type",
          "meaning",
          "unit",
          "evidence",
          "status"
        ],
        "properties": {
          "column": {
            "type": "string",
            "maxLength": 160
          },
          "type": {
            "type": "string",
            "maxLength": 40
          },
          "meaning": {
            "type": "string",
            "maxLength": 300
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "evidence": {
            "type": "string",
            "maxLength": 300
          },
          "status": {
            "enum": [
              "SOURCE_DOCUMENTED",
              "DEPLOYMENT_INFERRED",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
