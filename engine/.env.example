# Defaults stay off; do not copy a real key into this file.
# Allowed providers: off, bailian (preferred), deepseek. Keep off until trial scope/budget is approved.
AGENT_MODEL_PROVIDER=off
# First Bailian quality baseline candidate: qwen3.7-plus-2026-05-26
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
# Beijing dedicated workspace ID, not the display name. No 9POP production keys.
AGENT_BAILIAN_WORKSPACE_ID=
AGENT_PLATFORM_URL=http://127.0.0.1:18181
# Set TASK_ENGINE_TOKEN privately and identically on platform/engine.

# Requires matching platform opt-in and an explicit public query on each task.
AGENT_PUBLIC_WEB_ENABLED=false
# Optional public HTTPS SearXNG /search with JSON output enabled. No public instance is selected.
AGENT_SEARCH_ENDPOINT=
# Use the already configured primary model for server-authorized briefing workflows only.
AGENT_BRIEFING_USE_PRIMARY_MODEL=false
