{
  "name": "dreamcore-engine",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test tests/*.test.mjs && npm run licenses:check",
    "test:runtime": "npm run build && node --test tests/harness.test.mjs tests/sandbox.test.mjs",
    "licenses:write": "node scripts/notices.mjs",
    "licenses:check": "node scripts/notices.mjs --check",
    "test:candidate:public": "npm run build && node scripts/verify-candidate-public.mjs",
    "test:executor": "npm run build && node --test tests/integration/docker-sandbox.mjs",
    "model:smoke": "npm run build && node scripts/live-model-smoke.mjs",
    "test:model-smoke": "npm run build && node --test tests/live-model-smoke.test.mjs",
    "test:native": "npm run build && node --test tests/native-*.test.mjs",
    "test:native:container": "node scripts/verify-native-container.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@langfuse/otel": "6.0.0",
    "@langfuse/tracing": "6.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.1",
    "parse5": "8.0.1",
    "pptxgenjs": "4.0.1"
  },
  "overrides": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "image-size": "2.0.4",
    "zod": "4.6.6",
    "fflate": "0.8.3",
    "undici": "8.12.2",
    "@modelcontextprotocol/client": "2.3.0",
    "@opentelemetry/api": "$@opentelemetry/api"
  }
}
