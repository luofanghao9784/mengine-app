#!/bin/sh
# 本地防误推；不能替代远端权限与分支保护。
set -eu

is_zero() {
  case "$1" in
    ''|*[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$remote_ref" = refs/heads/main ] || continue

  if is_zero "$local_oid"; then
    echo '拒绝删除远端 main。' >&2
    exit 1
  fi

  if ! is_zero "$remote_oid"; then
    if ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
      echo '无法验证远端 main：请先 git fetch origin 后重试。' >&2
      exit 1
    fi
    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
      echo '拒绝非快进更新远端 main；请通过新提交或 revert 修复。' >&2
      exit 1
    fi
  fi

  if [ "${DREAMCORE_ALLOW_MAIN_PUSH:-}" != 1 ]; then
    echo 'main 默认通过 PR 集成。初始推送或已核验的人工集成可单次设置 DREAMCORE_ALLOW_MAIN_PUSH=1；该开关仍禁止删除和非快进更新。' >&2
    exit 1
  fi
done
